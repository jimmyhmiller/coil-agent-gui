;; Directory listing.
;;
;; Adapted from the harness's `src/infra/directory.coil`, which exists for the
;; same reason this does: `coil.fs` reaches files, not directories. `struct
;; dirent` is not one layout across platforms, so the field offsets are declared
;; per target rather than assumed.
;;
;;   Linux:  ino(8) off(8) reclen(2) type(1) name[256]            -- name at 19
;;   Darwin: ino(8) seekoff(8) reclen(2) namlen(2) type(1) name[] -- name at 21
(module coilgui.dir)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.os" :as os)

(extern opendir :cc c [(ptr i8)] (-> (ptr i8)))
(extern readdir :cc c [(ptr i8)] (-> (ptr i8)))
(extern closedir :cc c [(ptr i8)] (-> i32))
(extern access :cc c [(ptr i8) i32] (-> i32))
(extern mkdir :cc c [(ptr i8) u32] (-> i32))
(extern lseek :cc c [i32 i64 i32] (-> i64))
(extern close :cc c [i32] (-> i32))

(defn dirent--public-name [(name Code)] (-> Code)
  (primitive/syntax->datum name))

(defn gen-dirent-layout [] (-> Code)
  (if (primitive/code-eq (primitive/target-os) `linux)
      `(const ~(dirent--public-name `DIRENT_NAME_OFFSET) 19)
      `(const ~(dirent--public-name `DIRENT_NAME_OFFSET) 21)))

(meta (gen-dirent-layout))

(const DIRENT_NAME_MAX 1024)

(defn dirent-name [(allocator (ptr Allocator)) (entry (ptr i8))] (-> (slice u8))
  (let [bytes (primitive/cast (ptr u8) entry)
        start (primitive/index bytes DIRENT_NAME_OFFSET)
        (mut length) 0]
    (loop (if (or (>= (load length) DIRENT_NAME_MAX)
                  (= (primitive/cast i64 (load (primitive/index start (load length)))) 0))
              (break)
              (set! length (+ (load length) 1))))
    (let [(mut buffer) (sb-new allocator)
          (mut i) 0]
      (loop (if (>= (load i) (load length))
                (break)
                (do
                  (sb-push-byte! (mut buffer) (load (primitive/index start (load i))))
                  (set! i (+ (load i) 1)))))
      (sb-finish! (mut buffer)))))

;; Every name in `path`, excluding `.` and `..`. An unopenable directory is an
;; empty list, not an error: "there are no factories here" is a normal state.
(defn entries [(allocator (ptr Allocator)) (path (slice u8))] (-> (ArrayList (slice u8)))
  (let [(mut names) (al-new [(slice u8)] allocator)
        handle (opendir (str->cstr allocator path))]
    (when (!= (primitive/cast i64 handle) 0)
      (loop (let [entry (readdir handle)]
              (if (= (primitive/cast i64 entry) 0)
                  (break)
                  (let [name (dirent-name allocator entry)]
                    (when (not (or (= name ".") (= name "..")))
                      (al-push! [(slice u8)] (mut names) name)
                      0)
                    0))))
      (closedir handle)
      0)
    (load names)))

(defn entries-with-suffix [(allocator (ptr Allocator))
                           (path (slice u8))
                           (suffix (slice u8))] (-> (ArrayList (slice u8)))
  (let [all (entries allocator path)
        (mut matched) (al-new [(slice u8)] allocator)
        (mut i) 0
        n (al-len [(slice u8)] all)
        suffix-length (slice-len [u8] suffix)]
    (loop (if (>= (load i) n)
              (break)
              (let [name (al-get [(slice u8)] all (load i))
                    length (slice-len [u8] name)]
                (when (and (>= length suffix-length)
                           (= (substr name (- length suffix-length) length) suffix))
                  (al-push! [(slice u8)] (mut matched) name)
                  0)
                (set! i (+ (load i) 1)))))
    (load matched)))

(defn exists? [(allocator (ptr Allocator)) (path (slice u8))] (-> bool)
  (= (primitive/cast i64 (access (str->cstr allocator path) 0)) 0))

(defn make-dir [(allocator (ptr Allocator)) (path (slice u8)) (mode i64)] (-> i64)
  (primitive/cast i64 (mkdir (str->cstr allocator path) (primitive/cast u32 mode))))

;; A file's size without reading it or laying out `struct stat`, whose fields
;; move between platforms. Returns -1 when the file cannot be opened, which is
;; how a caller distinguishes "not there yet" from "empty".
(defn file-size [(allocator (ptr Allocator)) (path (slice u8))] (-> i64)
  (let [fd (os/open (str->cstr allocator path) 0)]
    (if (< (primitive/cast i64 fd) 0)
        -1
        (let [size (lseek fd 0 2)]
          (close fd)
          size))))
