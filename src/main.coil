;; Entry point: an offscreen renderer and a window, over the same draw call.
;;
;; `--render` writes one PNG per scene without opening anything, which is how the
;; interface is inspected and reviewed; the window runs the identical `draw-app!`
;; into a bitmap and hands it to the layer. Nothing about a view can be true in
;; one mode and false in the other.
(module coilgui.main)

(import "coil.alloc" :as alloc :use *)
(import "coil.args" :as args)
(import "coil.os" :as os)
(import "coil.arraylist" :use *)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coilgui.ffi" :use *)
(import "coilgui.theme" :use *)
(import "coilgui.draw" :use *)
(import "coilgui.marks" :use *)
(import "coilgui.model" :use *)
(import "coilgui.util" :use *)
(import "coilgui.view" :use *)
(import "coilgui.harness" :as harness)

(const WIDTH 1440)
(const HEIGHT 900)

(defn write-png [(ctx (ptr i8)) (path (ptr i8))] (-> i64)
  (let [image (CGBitmapContextCreateImage ctx)
        cf-path (CFStringCreateWithCString (nil-ptr) path CF_UTF8)
        url (CFURLCreateWithFileSystemPath (nil-ptr) cf-path 0 0)
        cf-type (CFStringCreateWithCString (nil-ptr) c"public.png" CF_UTF8)
        dest (CGImageDestinationCreateWithURL url cf-type 1 (nil-ptr))]
    (CGImageDestinationAddImage dest image (nil-ptr))
    (CGImageDestinationFinalize dest)
    (CGImageRelease image)
    0))

(defn set-input! [(app (ptr App)) (text (slice u8))] (-> i64)
  (let [(mut fresh) (al-new [u8] (.alc app))
        n (slice-len [u8] text)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! [u8] (mut fresh) (slice-get [u8] text (load i)))
                (set! i (+ (load i) 1)))))
    (set! (.input app) (load fresh))
    0))

(defn set-state! [(app (ptr App)) (at i64) (st State) (secs i64)] (-> i64)
  (let [s (step-at app at)]
    (set! (.state s) st)
    (set! (.secs s) secs)
    0))

;; The conversation that produced the plan. In the running scenes the right pane
;; shows the focused step's own transcript instead.
(defn plan-conversation! [(app (ptr App))] (-> i64)
  (lines-clear! app)
  (push-line! app (mk-line (You) "move the json writer onto the arena, and check" ""))
  (push-line! app (mk-line (Cont) "nothing else allocates its own buffer" ""))
  (push-line! app (mk-line (Agent) "Four steps. I read the three writers first, then" ""))
  (push-line! app (mk-line (Cont) "port the writer and the reader, then run the json" ""))
  (push-line! app (mk-line (Cont) "tests over both." ""))
  (push-line! app (mk-line (Agent) "The reader is the risky one — providers depend on" ""))
  (push-line! app (mk-line (Cont) "its signature. Say the word and I will drop it." ""))
  (push-line! app (mk-line (You) "keep it, but run the tests before the reader lands" ""))
  (push-line! app (mk-line (Agent) "Done — test depends on the writer only now." ""))
  0)

(defn running-conversation! [(app (ptr App))] (-> i64)
  (lines-clear! app)
  (push-line! app (mk-line (Tool) "Read  src/core/json.coil" ""))
  (push-line! app (mk-line (Result) "561 lines" ""))
  (push-line! app (mk-line (Agent) "The arena is only threaded through the writer. The" ""))
  (push-line! app (mk-line (Cont) "reader still takes an allocator argument." ""))
  (push-line! app (mk-line (Tool) "Edit  src/core/json.coil" "+18 −6"))
  (push-line! app (mk-line (Tool) "Bash  cargo test json" ""))
  (push-line! app (mk-line (Result) "running…" ""))
  (push-line! app (mk-line (Pending) "leave the reader alone for now — providers" ""))
  0)

(defn asks-conversation! [(app (ptr App))] (-> i64)
  (lines-clear! app)
  (push-line! app (mk-line (Tool) "Read  src/providers/openai_chat_wire.coil" ""))
  (push-line! app (mk-line (Result) "360 lines" ""))
  (push-line! app (mk-line (Agent) "The reader signature is public. Changing it breaks" ""))
  (push-line! app (mk-line (Cont) "two providers unless I port them in this step too." ""))
  (push-line! app (mk-line (Asks) "approve, or say what to do instead" ""))
  0)

(defn done-conversation! [(app (ptr App))] (-> i64)
  (lines-clear! app)
  (push-line! app (mk-line (Tool) "Bash  cargo test json" ""))
  (push-line! app (mk-line (Result) "47 passed" ""))
  (push-line! app (mk-line (Agent) "All four steps done. The wire codec still has its" ""))
  (push-line! app (mk-line (Cont) "own buffer — it was outside what you asked for." ""))
  (push-line! app (mk-line (You) "now do the same for the wire codec" ""))
  (push-line! app (mk-line (Agent) "One step, same shape. Run it and I will start." ""))
  0)

(defn scene! [(app (ptr App)) (which Scene)] (-> i64)
  (set! (.scene app) which)
  (set-input! app "")
  (match which
    (SceneNew []
              (do
                (steps-clear! app)
                (lines-clear! app)
                (set! (.title app) "untitled")
                (set! (.selected app) 1)
                0))
    (ScenePlan []
               (do
                 (propose-plan! app)
                 (plan-conversation! app)
                 (set! (.focus app) 1)
                 0))
    (SceneRunning []
                  (do
                    (propose-plan! app)
                    (set-state! app 0 (SDone) 22)
                    (set-state! app 1 (SRunning) 252)
                    (running-conversation! app)
                    (set! (.focus app) 1)
                    0))
    (SceneAsks []
               (do
                 (propose-plan! app)
                 (set-state! app 0 (SDone) 22)
                 (set-state! app 1 (SDone) 220)
                 (set-state! app 2 (SAsks) 65)
                 (asks-conversation! app)
                 (set! (.focus app) 2)
                 0))
    (SceneDone []
               (do
                 (propose-plan! app)
                 (set-state! app 0 (SDone) 22)
                 (set-state! app 1 (SDone) 220)
                 (set-state! app 2 (SDone) 138)
                 (set-state! app 3 (SDone) 31)
                 (done-conversation! app)
                 (set! (.focus app) 3)
                 0)))
  0)

(defn render-scene! [(app (ptr App)) (cv (ptr Canvas)) (ctx (ptr i8)) (which Scene) (path (ptr i8))] (-> i64)
  (scene! app which)
  (rail-sync! app)
  (draw-app! cv app (primitive/cast f64 WIDTH) (primitive/cast f64 HEIGHT))
  (write-png ctx path)
  0)

(defn render-all [] (-> i64)
  (let [a (malloc-allocator)
        app (alloc/stack App)
        cv (alloc/stack Canvas)
        space (CGColorSpaceCreateDeviceRGB)
        ctx (CGBitmapContextCreate (nil-ptr) (* WIDTH 2) (* HEIGHT 2) 8 0 space 1)]
    (app-init! app a)
    (if (= (canvas-init cv ctx (primitive/cast f64 HEIGHT) 2.0) 1)
        (do (println "fonts failed to load — run from the project root") 1)
        (do
          (render-scene! app cv ctx (SceneNew) c"shot-1-new.png")
          (render-scene! app cv ctx (ScenePlan) c"shot-2-plan.png")
          (render-scene! app cv ctx (SceneRunning) c"shot-3-running.png")
          (render-scene! app cv ctx (SceneAsks) c"shot-4-asks.png")
          (render-scene! app cv ctx (SceneDone) c"shot-5-done.png")
          (println "wrote 5 screenshots")
          0))))

;; ---------------------------------------------------------------- interaction

(defn send! [(app (ptr App))] (-> i64)
  (let [a (.alc app)
        text (own-str a (input-slice app))]
    (if (= (slice-len [u8] text) 0)
        0
        (let [asking (first-in-state app "asks")]
          (push-wrapped! app (You) text 52)
          (input-clear! app)
          (if (>= asking 0)
              (do
                (set! (.state (step-at app asking)) (SRunning))
                (push-wrapped! app (Agent) "Approved. Carrying on from where it stopped." 52)
                (set! (.running app) true)
                0)
              (planner-respond! app text))
          (rail-sync! app)
          0))))

;; Where the harness lives. One environment variable so this is not wired to my
;; machine, and a sibling checkout by default.
(defn harness-root [(a (ptr Allocator))] (-> (slice u8))
  (match (os/env-get a "COIL_HARNESS_ROOT")
    (Ok [found]
        (match found
          (Some [owned] (os/owned-string-slice owned))
          (None [] "../coil-agent-harness")))
    (Err [e] "../coil-agent-harness")))

;; The rail, from the factories actually on disk: one heading per project, one
;; row per workflow, each row remembering which workflow it came from.
(defn rail-build! [(app (ptr App)) (flows (ptr (ArrayList harness/Workflow)))] (-> i64)
  (let [a (.alc app)
        n (al-len [harness/Workflow] (load flows))
        (mut project) ""
        (mut i) 0]
    (set! (.items app) (al-new [Item] a))
    (loop (if (>= (load i) n)
              (break)
              (let [w (al-elem [harness/Workflow] flows (load i))
                    steps (al-len [(slice u8)] (.workers w))
                    done (.done w)]
                (when (!= (.project w) (load project))
                  (set! project (.project w))
                  (al-push! [Item] (field app items) (mk-item (.project w) "" (SQueued) "" true -1))
                  0)
                (al-push! [Item]
                          (field app items)
                          (mk-item (.project w)
                                   (.name w)
                                   (cond (= steps 0) (SQueued)
                                         (>= done steps) (SDone)
                                         (> done 0) (SRunning)
                                         :else (SQueued))
                                   ;; Copied out of the formatting ring: this
                                   ;; string outlives the frame that built it.
                                   (if (= steps 0)
                                       ""
                                       (own-str a (join3 (dec-str done) "/" (dec-str steps))))
                                   false
                                   (load i)))
                (set! i (+ (load i) 1)))))
    0))

(defn open-workflow! [(app (ptr App)) (flows (ptr (ArrayList harness/Workflow))) (at i64)] (-> i64)
  (when (and (>= at 0) (< at (al-len [harness/Workflow] (load flows))))
    (harness/load-into! app (al-elem [harness/Workflow] flows at))
    (set! (.open app) at)
    (set! (.focus app) 0)
    (harness/rebuild-lines! app)
    0)
  0)

(defn focus-next! [(app (ptr App))] (-> i64)
  (let [n (step-count app)]
    (when (> n 0)
      (store! (field app focus) (% (+ (.focus app) 1) n))
      0)
    0))

(defn new-workflow! [(app (ptr App))] (-> i64)
  (steps-clear! app)
  (lines-clear! app)
  (input-clear! app)
  (set! (.title app) "untitled")
  (set! (.running app) false)
  (set! (.focus app) 0)
  (set! (.selected app) 1)
  (rail-sync! app)
  0)

(defn click! [(app (ptr App))
              (cv (ptr Canvas))
              (flows (ptr (ArrayList harness/Workflow)))
              (px f64)
              (py f64)
              (w f64)
              (h f64)] (-> i64)
  (let [geom (alloc/stack Panes)]
    (set! geom (panes w h))
    (cond (< py HEADER)
            (if (not (run-hit cv app geom px py))
                0
                ;; Run means run: the harness starts the factory, and the journal it
                ;; writes is what this window then shows.
                (let [a (.alc app)
                      at (.open app)]
                  (if (< at 0)
                      0
                      (let [wf (al-elem [harness/Workflow] flows at)
                            pid (harness/start-run! a (harness-root a) (.folder wf))]
                        (println "started {s} · pid {d}" (.name wf) pid)
                        (set! (.running app) true)
                        0))))
          (< px (.rail geom))
            (let [hit (rail-hit app py)]
              (if (< hit 0)
                  0
                  (do
                    (set! (.selected app) hit)
                    (open-workflow! app flows (.source (al-elem [Item] (field app items) hit)))
                    0)))
          (< px (.convo-x geom))
            (let [hit (node-hit app geom px py)]
              (if (< hit 0)
                  0
                  (do
                    (set! (.focus app) hit)
                    ;; Selecting a step replays its own conversation out of the
                    ;; journal rather than filtering something already in memory.
                    (harness/rebuild-lines! app)
                    0)))
          :else 0)))

(defn hover! [(app (ptr App)) (cv (ptr Canvas)) (px f64) (py f64) (w f64) (h f64)] (-> i64)
  (let [geom (alloc/stack Panes)]
    (set! geom (panes w h))
    (let [in-rail (< px (.rail geom))
          in-graph (and (>= px (.rail geom)) (< px (.convo-x geom)))
          item (if (and in-rail (>= py HEADER)) (rail-hit app py) -1)
          node (if in-graph (node-hit app geom px py) -1)
          run (run-hit cv app geom px py)
          composer (and (> px (.convo-x geom)) (> py (- h 52.0)))]
      (set! (.hover-item app) item)
      (set! (.hover-node app) node)
      (set! (.hover-run app) run)
      (let [name
              (cond (or (or (>= item 0) (>= node 0)) run) c"pointingHandCursor"
                    composer c"IBeamCursor"
                    :else c"arrowCursor")
            cursor (msg (ptr i8) (objc-class c"NSCursor") (objc-sel name) [])]
        (msg (ptr i8) cursor (objc-sel c"set") []))
      0)))

(defn key! [(app (ptr App)) (ev (ptr i8)) (command bool)] (-> i64)
  (set! (field app typed) (.now app))
  (let [chars (msg (ptr i8) ev (objc-sel c"characters") [])]
    (if (null? chars)
        0
        (let [utf (msg (ptr i8) chars (objc-sel c"UTF8String") [])
              n (strlen utf)
              first (primitive/cast i64 (load (primitive/cast (ptr u8) utf)))]
          (if command
              (cond (= first 113) (do (os/_exit 0) 0)
                    (= first 110) (new-workflow! app)
                    (or (= first 13) (= first 10))
                      (if (and (> (step-count app) 0) (not (started? app)))
                          (do (run-start! app) (rail-sync! app) 0)
                          0)
                    :else 0)
              (cond (or (= first 13) (= first 10)) (send! app)
                    (= first 127) (input-backspace! app)
                    (= first 27) (input-clear! app)
                    (= first 9) (focus-next! app)
                    (>= first 32)
                      (let [(mut i) 0]
                        (loop (if (>= (load i) n)
                                  (break)
                                  (do
                                    (input-push! app
                                                 (load (primitive/index (primitive/cast (ptr u8) utf)
                                                                        (load i))))
                                    (store! i (+ (load i) 1)))))
                        0)
                    :else 0))))))

;; ---------------------------------------------------------------- window

(defn make-window [(w f64) (h f64)] (-> (ptr i8))
  (let [r (alloc/stack CGRect)
        alloc-win (msg (ptr i8) (objc-class c"NSWindow") (objc-sel c"alloc") [])]
    (set! (.x r) 120.0)
    (set! (.y r) 120.0)
    (set! (.w r) w)
    (set! (.h r) h)
    (msg (ptr i8)
         alloc-win
         (objc-sel c"initWithContentRect:styleMask:backing:defer:")
         [CGRect i64 i64 i64]
         (load r)
         ;; titled | closable | miniaturizable | resizable
         15
         2
         0)))

(defn blit! [(ctx (ptr i8)) (layer (ptr i8))] (-> i64)
  (let [image (CGBitmapContextCreateImage ctx)]
    (msg (ptr i8) layer (objc-sel c"setContents:") [(ptr i8)] image)
    (CGImageRelease image)
    0))

(defn pump! [(nsapp (ptr i8))
             (app (ptr App))
             (cv (ptr Canvas))
             (flows (ptr (ArrayList harness/Workflow)))
             (mode (ptr i8))
             (w f64)
             (h f64)] (-> i64)
  (loop (let [ev
                (msg (ptr i8)
                     nsapp
                     (objc-sel c"nextEventMatchingMask:untilDate:inMode:dequeue:")
                     [i64 (ptr i8) (ptr i8) i64]
                     -1
                     (nil-ptr)
                     mode
                     1)]
          (if (null? ev)
              (break)
              (let [ty (msg i64 ev (objc-sel c"type") [])
                    flags (msg i64 ev (objc-sel c"modifierFlags") [])
                    command (!= (primitive/iand flags 1048576) 0)]
                (when (= ty 1)
                  (let [p (msg CGPoint ev (objc-sel c"locationInWindow") [])]
                    (click! app cv flows (.x p) (- h (.y p)) w h))
                  0)
                (when (or (= ty 5) (= ty 6))
                  (let [p (msg CGPoint ev (objc-sel c"locationInWindow") [])]
                    (hover! app cv (.x p) (- h (.y p)) w h))
                  0)
                ;; A key this app has handled must NOT continue to the responder
                ;; chain. Nothing there handles it, and an unhandled key event is
                ;; precisely what makes AppKit beep on every keystroke.
                (if (= ty 10)
                    (key! app ev command)
                    (if (= ty 11)
                        0
                        (do (msg (ptr i8) nsapp (objc-sel c"sendEvent:") [(ptr i8)] ev) 0)))
                0))))
  0)

(defn run-window [] (-> i64)
  (let [a (malloc-allocator)
        app (alloc/stack App)
        cv (alloc/stack Canvas)
        space (CGColorSpaceCreateDeviceRGB)
        nsapp (msg (ptr i8) (objc-class c"NSApplication") (objc-sel c"sharedApplication") [])
        win (make-window (cast f64 WIDTH) (cast f64 HEIGHT))
        mode
          (msg (ptr i8)
               (objc-class c"NSString")
               (objc-sel c"stringWithUTF8String:")
               [(ptr i8)]
               c"kCFRunLoopDefaultMode")
        title (msg (ptr i8) (objc-class c"NSString") (objc-sel c"stringWithUTF8String:") [(ptr i8)] c"coil")
        root (harness-root a)
        (mut flows) (harness/discover a root "harness")
        ;; The live drawing surface. It is rebuilt whenever the window changes
        ;; size, which is the only reason any of this is mutable.
        (mut ctx) (CGBitmapContextCreate (nil-ptr) (* WIDTH 2) (* HEIGHT 2) 8 0 space 1)
        (mut cur-w) 0.0
        (mut cur-h) 0.0
        (mut cur-scale) 0.0]
    (app-init! app a)
    (rail-build! app (mut flows))
    (println "harness root {s} · {d} workflows" root (al-len [harness/Workflow] (load flows)))
    (when (> (al-len [harness/Workflow] (load flows)) 0)
      (set! (.selected app) 1)
      (open-workflow! app (mut flows) 0)
      0)
    (if (= (canvas-init cv (load ctx) (cast f64 HEIGHT) 2.0) 1)
        (do (println "fonts failed to load — run from the project root") 1)
        (do
          (msg (ptr i8) nsapp (objc-sel c"setActivationPolicy:") [i64] 0)
          (msg (ptr i8) win (objc-sel c"setTitle:") [(ptr i8)] title)
          (msg (ptr i8) win (objc-sel c"setAcceptsMouseMovedEvents:") [i64] 1)
          (msg (ptr i8) (msg (ptr i8) win (objc-sel c"contentView") []) (objc-sel c"setWantsLayer:") [i64] 1)
          (msg (ptr i8) win (objc-sel c"makeKeyAndOrderFront:") [(ptr i8)] (nil-ptr))
          (msg (ptr i8) nsapp (objc-sel c"activateIgnoringOtherApps:") [i64] 1)
          (msg (ptr i8) nsapp (objc-sel c"finishLaunching") [])
          (let [view (msg (ptr i8) win (objc-sel c"contentView") [])
                layer (msg (ptr i8) view (objc-sel c"layer") [])
                (mut frame) 0]
            (loop (do
                    ;; One clock per frame: every animation is a function of how
                    ;; long ago something happened, never of a frame count.
                    (set! (.now app) (CACurrentMediaTime))
                    ;; Closing the window ends the process; there is no menu bar
                    ;; to quit from and a stranded loop would outlive the window.
                    (when (= (msg i64 win (objc-sel c"isVisible") []) 0) (break) 0)
                    (let [bounds (msg CGRect view (objc-sel c"bounds") [])
                          scale (msg f64 win (objc-sel c"backingScaleFactor") [])
                          w (.w bounds)
                          h (.h bounds)]
                      ;; A resize rebuilds the bitmap at the new size. Everything
                      ;; else in the app works in points and never learns of it.
                      ;; f64 has no Eq on purpose (NaN), so compare explicitly.
                      (when (or (or (primitive/fcmp-ne w (load cur-w))
                                    (primitive/fcmp-ne h (load cur-h)))
                                (primitive/fcmp-ne scale (load cur-scale)))
                        (CGContextRelease (load ctx))
                        (set! ctx
                              (CGBitmapContextCreate (nil-ptr)
                                                     (cast i64 (* w scale))
                                                     (cast i64 (* h scale))
                                                     8
                                                     0
                                                     space
                                                     1))
                        (canvas-resize! cv (load ctx) h scale)
                        (set! cur-w w)
                        (set! cur-h h)
                        (set! cur-scale scale)
                        0)
                      (pump! nsapp app cv (mut flows) mode w h)
                      (when (and (.running app) (>= (.open app) 0))
                        (when (= (% (load frame) 30) 29)
                          (let [wf (al-elem [harness/Workflow] (mut flows) (.open app))]
                            (when (harness/journal-changed? a root wf)
                              (harness/refresh! a root wf)
                              (harness/load-into! app wf)
                              (harness/rebuild-lines! app)
                              (rail-build! app (mut flows))
                              0)
                            0)
                          0)
                        0)
                      (draw-app! cv app w h)
                      (blit! (load ctx) layer)
                      0)
                    (set! frame (+ (load frame) 1))
                    (usleep 16000))))
          0))))

(defn type-and-send! [(app (ptr App)) (text (slice u8))] (-> i64)
  (set-input! app text)
  (send! app)
  0)

(defn demo [] (-> i64)
  (let [a (malloc-allocator)
        app (alloc/stack App)
        cv (alloc/stack Canvas)
        space (CGColorSpaceCreateDeviceRGB)
        ctx (CGBitmapContextCreate (nil-ptr) (* WIDTH 2) (* HEIGHT 2) 8 0 space 1)]
    (app-init! app a)
    (if (= (canvas-init cv ctx (primitive/cast f64 HEIGHT) 2.0) 1)
        (do (println "fonts failed to load — run from the project root") 1)
        (do
          (new-workflow! app)
          (type-and-send! app "port the json writer onto the arena")
          (draw-app! cv app (primitive/cast f64 WIDTH) (primitive/cast f64 HEIGHT))
          (write-png ctx c"demo-1-planned.png")

          (type-and-send! app "add bench")
          (draw-app! cv app (primitive/cast f64 WIDTH) (primitive/cast f64 HEIGHT))
          (write-png ctx c"demo-2-added.png")

          (type-and-send! app "drop bench")
          (draw-app! cv app (primitive/cast f64 WIDTH) (primitive/cast f64 HEIGHT))
          (write-png ctx c"demo-3-dropped.png")

          (run-start! app)
          (advance! app)
          (advance! app)
          (rail-sync! app)
          (draw-app! cv app (primitive/cast f64 WIDTH) (primitive/cast f64 HEIGHT))
          (write-png ctx c"demo-4-running.png")

          (println "steps {d} · running {d} · done {d}"
                   (step-count app)
                   (count-in-state app "running")
                   (count-in-state app "done"))
          0))))

;; The real thing, headless: discover the harness on disk, open a workflow, and
;; render it. Same code path as the window, so what this writes is what the
;; window shows.
(defn render-real [(which i64) (w f64) (h f64)] (-> i64)
  (let [a (malloc-allocator)
        app (alloc/stack App)
        cv (alloc/stack Canvas)
        space (CGColorSpaceCreateDeviceRGB)
        ctx (CGBitmapContextCreate (nil-ptr) (cast i64 (* w 2.0)) (cast i64 (* h 2.0)) 8 0 space 1)
        root (harness-root a)
        (mut flows) (harness/discover a root "harness")
        n (al-len [harness/Workflow] (load flows))]
    (app-init! app a)
    (rail-build! app (mut flows))
    (println "harness root {s} · {d} workflows" root n)
    (if (= n 0)
        (do (println "no factories found — is COIL_HARNESS_ROOT right?") 1)
        (do
          (let [(mut i) 0]
            (loop (if (>= (load i) n)
                      (break)
                      (let [w (al-elem [harness/Workflow] (mut flows) (load i))]
                        (println "  {s}  {d} steps  {d} done  journal={s}"
                                 (.name w)
                                 (al-len [(slice u8)] (.workers w))
                                 (.done w)
                                 (.journal w))
                        (set! i (+ (load i) 1))))))
          (set! (.selected app) (+ which 1))
          (open-workflow! app (mut flows) which)
          (if (= (canvas-init cv ctx h 2.0) 1)
              (do (println "fonts failed to load") 1)
              (do
                (draw-app! cv app w h)
                (write-png ctx c"real.png")
                (println "wrote real.png · {d} steps · {d} lines"
                         (step-count app)
                         (al-len [Line] (.lines app)))
                0))))))

;; Drives the real click path headlessly at a given point, so hit testing can be
;; separated from event delivery when a click "does nothing".
(defn click-probe [(px f64) (py f64)] (-> i64)
  (let [a (malloc-allocator)
        app (alloc/stack App)
        cv (alloc/stack Canvas)
        space (CGColorSpaceCreateDeviceRGB)
        ctx (CGBitmapContextCreate (nil-ptr) (* WIDTH 2) (* HEIGHT 2) 8 0 space 1)
        root (harness-root a)
        (mut flows) (harness/discover a root "harness")]
    (app-init! app a)
    (rail-build! app (mut flows))
    (canvas-init cv ctx (primitive/cast f64 HEIGHT) 2.0)
    (open-workflow! app (mut flows) 0)
    (println "before: selected={d} open={d} focus={d} title={s} steps={d} lines={d}"
             (.selected app)
             (.open app)
             (.focus app)
             (.title app)
             (step-count app)
             (al-len [Line] (.lines app)))
    (println "rail-hit({d}) = {d}"
             (primitive/cast i64 py)
             (rail-hit app py))
    (let [geom (alloc/stack Panes)]
      (set! geom (panes (cast f64 WIDTH) (cast f64 HEIGHT)))
      (println "node-hit = {d}" (node-hit app geom px py)))
    (let [hit (rail-hit app py)]
      (when (>= hit 0)
        (let [it (al-elem [Item] (field app items) hit)]
          (println "  item {d}: name={s} source={d} head={d}"
                   hit
                   (.name it)
                   (.source it)
                   (if (.head it) 1 0)))
        0))
    (println "items={d} flows={d}"
             (al-len [Item] (.items app))
             (al-len [harness/Workflow] (load flows)))
    (click! app cv (mut flows) px py (cast f64 WIDTH) (cast f64 HEIGHT))
    (println "after:  selected={d} open={d} focus={d} title={s} steps={d} lines={d}"
             (.selected app)
             (.open app)
             (.focus app)
             (.title app)
             (step-count app)
             (al-len [Line] (.lines app)))
    0))

;; Proves the spawn path without starting an agent run, which costs money and
;; minutes. If this writes the file, Run will start the harness.
(defn spawn-test [] (-> i64)
  (let [a (malloc-allocator)
        pid (harness/spawn-shell a "echo ok > /tmp/coilgui-spawn.txt")]
    (println "spawned pid {d}" pid)
    0))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (if (and (> (primitive/cast i64 argc) 1)
           (= (cstr->str (load (primitive/index argv 1))) "--render"))
      (render-all)
      (if (and (> (primitive/cast i64 argc) 1)
               (= (cstr->str (load (primitive/index argv 1))) "--demo"))
          (demo)
          (if (and (> (primitive/cast i64 argc) 1)
                   (= (cstr->str (load (primitive/index argv 1))) "--real"))
              (render-real 0
                           (if (> (cast i64 argc) 2)
                               (cast f64
                                     (match (str-parse-int (cstr->str (load (index argv 2))))
                                       (Some [v] v)
                                       (None [] WIDTH)))
                               (cast f64 WIDTH))
                           (if (> (cast i64 argc) 3)
                               (cast f64
                                     (match (str-parse-int (cstr->str (load (index argv 3))))
                                       (Some [v] v)
                                       (None [] HEIGHT)))
                               (cast f64 HEIGHT)))
              (if (and (> (primitive/cast i64 argc) 1)
                       (= (cstr->str (load (primitive/index argv 1))) "--spawn-test"))
                  (spawn-test)
                  (if (and (> (primitive/cast i64 argc) 3)
                           (= (cstr->str (load (primitive/index argv 1))) "--click"))
                      (click-probe (primitive/cast f64
                                                   (match (str-parse-int (cstr->str (load (primitive/index argv 2))))
                                                     (Some [v] v)
                                                     (None [] 0)))
                                   (primitive/cast f64
                                                   (match (str-parse-int (cstr->str (load (primitive/index argv 3))))
                                                     (Some [v] v)
                                                     (None [] 0))))
                      (run-window)))))))
