;; The three panes.
;;
;; Left: what exists. Middle: the shape of the one you picked. Right: the one
;; conversation you are reading. Every separation is a hairline; nothing is
;; filled except a selected row, and nothing is rounded.
(module coilgui.view)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coilgui.ffi" :use *)
(import "coilgui.theme" :use *)
(import "coilgui.draw" :use *)
(import "coilgui.marks" :use *)
(import "coilgui.model" :use *)
(import "coilgui.util" :use *)

;; The pane geometry, derived from the window rather than declared. Drawing and
;; hit testing both take one of these, which is what keeps a click and the thing
;; it appears to be on from drifting apart when the window is resized.
(defstruct Panes [(w f64) (h f64) (rail f64) (graph f64) (convo-x f64) (convo f64)])

(defn panes [(w f64) (h f64)] (-> Panes)
  (let [p (alloc/stack Panes)
        rail RAIL_W
        wide (- w rail)
        ;; The conversation takes a share of what is left, within bounds: narrow
        ;; enough and the graph has no room, wide enough and prose stops wrapping
        ;; at a readable measure.
        convo
          (cond (< (* wide 0.42) 360.0) (if (< wide 720.0) (* wide 0.5) 360.0)
                (> (* wide 0.42) 620.0) 620.0
                :else (* wide 0.42))]
    (set! (field p w) w)
    (set! (field p h) h)
    (set! (field p rail) rail)
    (set! (field p graph) (- wide convo))
    (set! (field p convo-x) (+ rail (- wide convo)))
    (set! (field p convo) convo)
    (load p)))

(const COL_GAP 150.0)
(const ROW_GAP 64.0)

(defn state-color [(s State)] (-> Color)
  (match s
    (SQueued [] (ink3))
    (SRunning [] (amber))
    (SDone [] (green))
    (SFailed [] (red))
    (SAsks [] (amber))))

;; Every state mark in one place, so the graph and the rail can never drift.
(defn state-mark! [(cv (ptr Canvas)) (s State) (cx f64) (cy f64) (now f64)] (-> i64)
  (match s
    (SQueued [] (pending! cv cx cy (ink3)))
    (SRunning [] (spinner! cv cx cy 3.5 now (amber)))
    (SDone [] (check! cv cx cy (green)))
    (SFailed [] (cross! cv cx cy (red)))
    (SAsks [] (do (text-at! cv (field cv m12) (- cx 3.5) (+ cy 4.0) (amber) "?") 0))))

;; ---------------------------------------------------------------- rail

(defn draw-rail! [(cv (ptr Canvas)) (app (ptr App)) (h f64)] (-> i64)
  (let [n (al-len [Item] (.items app))
        (mut y) (+ HEADER 20.0)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [it (al-elem [Item] (field app items) (load i))
                    selected (= (load i) (.selected app))]
                (if (.head it)
                    (do
                      (when (> (load i) 0)
                        (store! y (+ (load y) 14.0))
                        0)
                      (text-tracked! cv
                                     (field cv f11)
                                     GUTTER_RAIL
                                     (row-baseline (field cv f11) (load y) 22.0)
                                     (ink3)
                                     (.project it)
                                     1.4)
                      (set! y (+ (load y) 26.0))
                      0)
                    (let [top (load y)
                          name (.name it)
                          ;; The open workflow reports live counts; every other
                          ;; row reports what its last run left behind.
                          meta
                            (if (and (>= (.source it) 0) (= (.source it) (.open app)))
                                (if (= (step-count app) 0)
                                    ""
                                    (join3 (dec-str (count-in-state app "done")) "/" (dec-str (step-count app))))
                                (.meta it))
                          st (.state it)]
                      (when (and (not selected) (= (load i) (.hover-item app)))
                        (fill! cv 0.0 top RAIL_W ROW (hover-wash))
                        0)
                      (when selected
                        (fill! cv 0.0 top RAIL_W ROW (amber-wash))
                        (fill! cv 0.0 top 2.0 ROW (amber))
                        0)
                      (state-mark! cv st (+ GUTTER_RAIL 5.0) (+ top (/ ROW 2.0)) (.now app))
                      (text-elided! cv
                                    (field cv f12)
                                    (+ GUTTER_RAIL 20.0)
                                    top
                                    ROW
                                    150.0
                                    (if selected (ink1) (if (= (state-word st) "done") (ink3) (ink2)))
                                    name)
                      (when (> (slice-len [u8] meta) 0)
                        (text-row! cv
                                   (field cv f11)
                                   (text-right (field cv f11) (- RAIL_W GUTTER_RAIL) meta)
                                   top
                                   ROW
                                   (ink3)
                                   meta)
                        0)
                      (set! y (+ (load y) ROW))
                      0))
                (set! i (+ (load i) 1)))))
    (hline! cv 0.0 (- h 42.0) RAIL_W (line))
    (text-row! cv (field cv f11) GUTTER_RAIL (- h 42.0) 42.0 (ink3) "⌘N   new")
    (vline! cv (- RAIL_W HAIRLINE) 0.0 h (line))
    0))

;; ---------------------------------------------------------------- graph

(defn node-x [(x0 f64) (col i64)] (-> f64)
  (+ x0 (* COL_GAP (primitive/cast f64 col))))

(defn node-y [(y0 f64) (row i64)] (-> f64)
  (+ y0 (* ROW_GAP (primitive/cast f64 row))))

(defn draw-edge! [(cv (ptr Canvas))
                  (x0 f64)
                  (y0 f64)
                  (from (ptr Step))
                  (to (ptr Step))
                  (dashed bool)] (-> i64)
  (let [fx (+ (node-x x0 (.col from)) NODE_W)
        fy (+ (node-y y0 (.row from)) (/ NODE_H 2.0))
        tx (node-x x0 (.col to))
        ty (+ (node-y y0 (.row to)) (/ NODE_H 2.0))
        mid (+ fx 16.0)]
    (path! cv (line) dashed)
    (seg! cv fx fy mid fy)
    (seg! cv mid fy mid ty)
    (seg! cv mid ty tx ty)
    (end-path! cv)))

(defn draw-node! [(cv (ptr Canvas))
                  (x0 f64)
                  (y0 f64)
                  (s (ptr Step))
                  (focused bool)
                  (hot bool)
                  (now f64)] (-> i64)
  (let [arrive (ease-out (phase now (.born s) ANIM_STEP))
        settle (phase now (.changed s) ANIM_STEP)
        x (node-x x0 (.col s))
        y (- (node-y y0 (.row s)) (* 6.0 (- 1.0 arrive)))
        st (.state s)
        machine (.machine s)
        resting
          (if focused
              (amber)
              (if (= (state-word st) "queued") (line-quiet) (line)))
        ;; A step that just changed state flashes its border toward amber and
        ;; settles back, so the change is visible without anything moving.
        ;; ease-out(1) is exactly 1, so a settled node mixes to its resting
        ;; colour and no branch is needed.
        border (mix (amber) resting (ease-out settle))]
    (canvas-alpha! cv arrive)
    (when hot (fill! cv x y NODE_W NODE_H (hover-wash)) 0)
    (box! cv x y NODE_W NODE_H border)
    (text-elided! cv
                  (field cv f12)
                  (+ x 12.0)
                  y
                  NODE_H
                  88.0
                  (if (= (state-word st) "queued") (ink3) (if (= (state-word st) "done") (ink2) (ink1)))
                  (.name s))
    (state-mark! cv st (+ x (- NODE_W 14.0)) (+ y (/ NODE_H 2.0)) now)
    (when (> (slice-len [u8] machine) 0)
      (hop! cv (+ x 12.0) (+ y (+ NODE_H 12.0)) (ink3))
      (text-at! cv (field cv f11) (+ x 24.0) (+ y (+ NODE_H 16.0)) (ink3) machine)
      0)
    (canvas-alpha! cv 1.0)
    0))

(defn max-row [(app (ptr App))] (-> i64)
  (let [n (step-count app)
        (mut i) 0
        (mut top) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [r (.row (step-at app (load i)))]
                (when (> r (load top)) (store! top r) 0)
                (set! i (+ (load i) 1)))))
    (load top)))

;; "" when the count is zero, so the footer lists only what is actually there.
(defn count-label [(n i64) (word (slice u8))] (-> (slice u8))
  (if (= n 0) "" (join2 (dec-str n) word)))

(defn foot-part! [(cv (ptr Canvas)) (x f64) (top f64) (c Color) (label (slice u8)) (first bool)] (-> f64)
  (if (= (slice-len [u8] label) 0)
      x
      (let [at (if first x (+ x 14.0))]
        (when (not first)
          (text-row! cv (field cv f11) x top 42.0 (line) "·")
          0)
        (+ at (+ (text-row! cv (field cv f11) at top 42.0 c label) 4.0)))))

(defn draw-graph! [(cv (ptr Canvas)) (app (ptr App)) (p (ptr Panes)) (x f64) (w f64) (h f64)] (-> i64)
  (let [n (step-count app)
        x0 (+ x 36.0)
        rows (+ 1 (max-row app))
        block (- (* ROW_GAP (primitive/cast f64 rows)) (- ROW_GAP NODE_H))
        y0 (+ HEADER (/ (- (- (- h HEADER) 42.0) block) 2.0))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [s (step-at app (load i))
                    from (.from s)
                    join (.join s)]
                (when (>= from 0)
                  (draw-edge! cv
                              x0
                              y0
                              (step-at app from)
                              s
                              (> (slice-len [u8] (.machine s)) 0))
                  0)
                (when (>= join 0)
                  (draw-edge! cv x0 y0 (step-at app join) s false)
                  0)
                (set! i (+ (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) n)
              (break)
              (do
                (draw-node! cv
                            x0
                            y0
                            (step-at app (load i))
                            (and (started? app) (= (load i) (.focus app)))
                            (= (load i) (.hover-node app))
                            (.now app))
                (set! i (+ (load i) 1)))))
    (hline! cv x (- h 42.0) w (line))
    (let [(mut lx) (+ x GUTTER_PANE)
          foot-top (- h 42.0)]
      (if (= n 0)
          (do (text-row! cv (field cv f11) (load lx) foot-top 42.0 (ink3) "no steps yet") 0)
          (do
            (set! lx
                  (foot-part! cv
                              (load lx)
                              foot-top
                              (ink3)
                              (join2 (dec-str n) (if (= n 1) " step" " steps"))
                              true))
            (set! lx
                  (foot-part! cv
                              (load lx)
                              foot-top
                              (green)
                              (count-label (count-in-state app "done") " done")
                              false))
            (set! lx
                  (foot-part! cv
                              (load lx)
                              foot-top
                              (amber)
                              (count-label (count-in-state app "running") " running")
                              false))
            (set! lx
                  (foot-part! cv
                              (load lx)
                              foot-top
                              (amber)
                              (count-label (count-in-state app "asks") " waiting on you")
                              false))
            (set! lx
                  (foot-part! cv
                              (load lx)
                              foot-top
                              (red)
                              (count-label (count-in-state app "failed") " failed")
                              false))
            (set! lx
                  (foot-part! cv
                              (load lx)
                              foot-top
                              (ink3)
                              (count-label (count-in-state app "queued") " queued")
                              false))
            0)))
    (vline! cv (- (+ x w) HAIRLINE) 0.0 h (line))
    0))

;; ---------------------------------------------------------------- conversation

(defn draw-line-reset! [(cv (ptr Canvas)) (v f64)] (-> f64)
  (canvas-alpha! cv 1.0)
  v)

(defn draw-line! [(cv (ptr Canvas)) (app (ptr App)) (l (ptr Line)) (x f64) (w f64) (top-in f64)] (-> f64)
  (let [arrive (ease-out (phase (.now app) (.born l) ANIM_FAST))
        top (- top-in (* 4.0 (- 1.0 arrive)))
        text (.text l)
        trail (.trail l)
        body-x (+ x 20.0)
        room (- (- w 40.0) 20.0)]
    (canvas-alpha! cv arrive)
    (draw-line-reset! cv
                      (match (.who l)
                        (You []
                             (do
                               (caret! cv (+ x 4.0) (+ top (/ LINE_H 2.0)) (amber))
                               (text-elided! cv (field cv f13) body-x top LINE_H room (ink1) text)
                               (+ top LINE_H)))
                        (Agent []
                               (do
                                 (dot! cv (+ x 4.0) (+ top (/ LINE_H 2.0)) 2.6 (ink1))
                                 (text-elided! cv (field cv f13) body-x top LINE_H room (ink2) text)
                                 (+ top LINE_H)))
                        (Cont []
                              (do
                                (text-elided! cv (field cv f13) body-x top LINE_H room (ink2) text)
                                (+ top LINE_H)))
                        (Tool []
                              (do
                                (ring! cv (+ x 4.0) (+ top (/ LINE_H 2.0)) 3.0 (ink3))
                                (text-elided! cv (field cv m13) body-x top LINE_H (- room 90.0) (ink1) text)
                                (when (> (slice-len [u8] trail) 0)
                                  (text-row! cv
                                             (field cv f11)
                                             (text-right (field cv f11) (- (+ x w) GUTTER_PANE) trail)
                                             top
                                             LINE_H
                                             (green)
                                             trail)
                                  0)
                                (+ top LINE_H)))
                        (Result []
                                (do
                                  (elbow! cv (+ x 22.0) (+ top (/ LINE_H 2.0)) (ink3))
                                  (text-elided! cv (field cv f13) (+ x 34.0) top LINE_H (- room 14.0) (ink3) text)
                                  (+ top LINE_H)))
                        (Pending []
                                 (do
                                   (fill! cv x top 2.0 (* LINE_H 2.0) (line))
                                   (caret! cv (+ x 14.0) (+ top (/ LINE_H 2.0)) (amber))
                                   (text-elided! cv (field cv f13) (+ x 28.0) top LINE_H (- room 28.0) (ink2) text)
                                   (text-row! cv
                                              (field cv f11)
                                              (+ x 28.0)
                                              (+ top LINE_H)
                                              LINE_H
                                              (ink3)
                                              "queued · delivered at the next turn boundary")
                                   (+ top (* LINE_H 2.0))))
                        (Asks []
                              (do
                                (text-at! cv (field cv m13) (+ x 1.0) (+ top 15.0) (amber) "?")
                                (text-elided! cv (field cv f13) body-x top LINE_H room (amber) text)
                                (+ top LINE_H)))))))

(defn draw-composer! [(cv (ptr Canvas))
                      (app (ptr App))
                      (x f64)
                      (w f64)
                      (h f64)
                      (hint (slice u8))
                      (placeholder (slice u8))] (-> i64)
  (let [top (- h 52.0)
        text (al-slice [u8] (.input app))
        base (+ x GUTTER_PANE)
        empty (= (slice-len [u8] text) 0)]
    (hline! cv x top w (line))
    (caret! cv (+ base 4.0) (+ top 26.0) (amber))
    (let [tw
            (if empty
                ;; The placeholder starts past the cursor rather than under it.
                (do
                  (text-elided! cv (field cv f13) (+ base 36.0) top 52.0 (- w 220.0) (line) placeholder)
                  0.0)
                (text-elided! cv (field cv f13) (+ base 18.0) top 52.0 (- w 200.0) (ink1) text))]
      ;; The cursor does not blink. It is a position, not an alarm: a blinking
      ;; block is movement the user did not cause, in the one place they are
      ;; already looking.
      (fill! cv (+ (+ base 20.0) tw) (+ top 18.0) 8.0 16.0 (amber)))
    (when (> (slice-len [u8] hint) 0)
      (text-row! cv
                 (field cv f11)
                 (text-right (field cv f11) (- (+ x w) GUTTER_PANE) hint)
                 top
                 52.0
                 (ink3)
                 hint)
      0)
    0))

(defn line-height [(l (ptr Line))] (-> f64)
  (match (.who l)
    (Pending [] (* LINE_H 2.0))
    (_ LINE_H)))

;; The conversation is anchored to the bottom, like a terminal: a replayed run
;; is hundreds of lines and the part worth reading is the end of it. When it
;; fits, it sits at the top as normal.
(defn draw-convo! [(cv (ptr Canvas)) (app (ptr App)) (p (ptr Panes)) (x f64) (w f64) (h f64)] (-> i64)
  (let [n (al-len [Line] (.lines app))
        top (+ HEADER 22.0)
        bottom (- h 66.0)
        (mut total) 0.0
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [l (al-elem [Line] (field app lines) (load i))
                    follows
                      (if (>= (+ (load i) 1) n)
                          false
                          (match (.who (al-elem [Line] (field app lines) (+ (load i) 1)))
                            (Cont [] true)
                            (_ false)))]
                (set! total (+ (load total) (+ (line-height l) (if follows 0.0 8.0))))
                (set! i (+ (load i) 1)))))
    (let [(mut y) (if (< (load total) (- bottom top)) top (- bottom (load total)))]
      (clip-push! cv x HEADER w (- (- h HEADER) 52.0))
      (set! i 0)
      (loop (if (>= (load i) n)
                (break)
                (let [l (al-elem [Line] (field app lines) (load i))
                      next (draw-line! cv app l (+ x GUTTER_PANE) (- w GUTTER_PANE) (load y))
                      follows
                        (if (>= (+ (load i) 1) n)
                            false
                            (match (.who (al-elem [Line] (field app lines) (+ (load i) 1)))
                              (Cont [] true)
                              (_ false)))]
                  (set! y (if follows next (+ next 8.0)))
                  (set! i (+ (load i) 1)))))
      (clip-pop! cv))
    (draw-composer! cv
                    app
                    x
                    w
                    h
                    (cond (= (step-count app) 0) ""
                          (> (count-in-state app "asks") 0) "answer, or say what to do instead"
                          (not (started? app)) "keep talking to change the plan"
                          (> (count-in-state app "running") 0) "the workflow keeps running"
                          (= (count-in-state app "done") (step-count app)) "a change starts the next run"
                          :else "keep talking")
                    (if (started? app)
                        (join2 "message " (.name (step-at app (.focus app))))
                        "message the plan"))
    0))

(defn run-button! [(cv (ptr Canvas)) (right f64) (top f64) (label (slice u8)) (hot bool)] (-> f64)
  (let [w (+ (text-width (field cv f11) label) 24.0)
        x (- right w)
        y (+ top 13.0)]
    (when hot (fill! cv x y w 22.0 (amber-wash)) 0)
    (box! cv x y w 22.0 (amber))
    (text-row! cv (field cv f11) (+ x 12.0) y 22.0 (amber) label)
    x))

(defn draw-header! [(cv (ptr Canvas)) (app (ptr App)) (p (ptr Panes)) (split bool)] (-> i64)
  (let [n (step-count app)
        started
          (> (+ (count-in-state app "running")
                (+ (count-in-state app "done")
                   (+ (count-in-state app "failed") (count-in-state app "asks"))))
             0)
        title (.title app)
        w (.w p)
        graph-w (.graph p)]
    (hline! cv 0.0 (- HEADER HAIRLINE) w (line))
    (text-row! cv (field cv m13) GUTTER_RAIL 0.0 HEADER (ink1) "coil")
    (text-row! cv
               (field cv f11)
               (text-right (field cv f11) (- (.rail p) GUTTER_RAIL) "⌘K")
               0.0
               HEADER
               (ink3)
               "⌘K")
    (if (not split)
        (do (text-row! cv (field cv f13) (+ (.rail p) GUTTER_PANE) 0.0 HEADER (ink3) title) 0)
        (let [mid-right (+ (.rail p) graph-w)]
          (text-elided! cv (field cv m13) (+ (.rail p) GUTTER_PANE) 0.0 HEADER (- graph-w 180.0) (ink1) title)
          (if (and (> n 0) (not started))
              (do (run-button! cv (- mid-right GUTTER_PANE) 0.0 (join3 "Run " (dec-str n) " steps") (.hover-run app)) 0)
              (do
                (text-row! cv
                           (field cv f11)
                           (text-right (field cv f11)
                                       (- mid-right GUTTER_PANE)
                                       (join3 (dec-str (count-in-state app "done")) "/" (dec-str n)))
                           0.0
                           HEADER
                           (ink3)
                           (join3 (dec-str (count-in-state app "done")) "/" (dec-str n)))
                0))
          (if (not (started? app))
              (do
                (text-row! cv (field cv m13) (+ mid-right GUTTER_PANE) 0.0 HEADER (ink1) "plan")
                (text-row! cv
                           (field cv f11)
                           (text-right (field cv f11) (- w GUTTER_PANE) "not started")
                           0.0
                           HEADER
                           (ink3)
                           "not started")
                0)
              (when (> n 0)
                (let [f (step-at app (.focus app))
                      machine (.machine f)
                      st (.state f)
                      name-w
                        (text-elided! cv
                                      (field cv m13)
                                      (+ mid-right GUTTER_PANE)
                                      0.0
                                      HEADER
                                      220.0
                                      (ink1)
                                      (.name f))]
                  (when (> (slice-len [u8] machine) 0)
                    (hop! cv (+ (+ mid-right GUTTER_PANE) (+ name-w 12.0)) (/ HEADER 2.0) (ink3))
                    (text-row! cv
                               (field cv f11)
                               (+ (+ mid-right GUTTER_PANE) (+ name-w 23.0))
                               0.0
                               HEADER
                               (ink3)
                               machine)
                    0)
                  (let [word (if (= (state-word st) "asks") "waiting on you" (state-word st))
                        secs (.secs f)
                        label (if (> secs 0) (join3 word " " (clock-str secs)) word)]
                    (text-row! cv
                               (field cv f11)
                               (text-right (field cv f11) (- w GUTTER_PANE) label)
                               0.0
                               HEADER
                               (state-color st)
                               label)
                    0))))
          0))
    0))

;; ---------------------------------------------------------------- empty state

;; A new workflow is one prompt in the middle of the window. The panes appear
;; when there is something to put in them, not before.
(defn draw-new! [(cv (ptr Canvas)) (app (ptr App)) (p (ptr Panes)) (x f64) (w f64) (h f64)] (-> i64)
  (let [box-w 620.0
        left (+ x (/ (- w box-w) 2.0))
        top (- (/ h 2.0) 110.0)
        text (al-slice [u8] (.input app))
        empty (= (slice-len [u8] text) 0)]
    (text-row! cv
               (field cv f12)
               left
               top
               22.0
               (ink3)
               "describe what should happen. steps appear as you talk.")
    (caret! cv (+ left 5.0) (+ top 62.0) (amber))
    (let [tw
            (text-elided! cv
                          (field cv f13)
                          (+ left 20.0)
                          (+ top 50.0)
                          24.0
                          (- box-w 40.0)
                          (if empty (line) (ink1))
                          (if empty "what should this do?" text))]
      (when (not empty)
        (fill! cv (+ (+ left 22.0) tw) (+ top 55.0) 8.0 16.0 (amber))
        0))
    (hline! cv left (+ top 82.0) box-w (line))
    (text-row! cv (field cv f11) left (+ top 92.0) 22.0 (ink3) "⏎ send · ⇧⏎ newline")
    0))

;; ---------------------------------------------------------------- whole window

(defn draw-app! [(cv (ptr Canvas)) (app (ptr App)) (w f64) (h f64)] (-> i64)
  (let [split (> (step-count app) 0)
        geom (alloc/stack Panes)]
    (set! geom (panes w h))
    (fill! cv 0.0 0.0 w h (ground))
    (if split
        (do
          (draw-graph! cv app geom (.rail geom) (.graph geom) h)
          (draw-convo! cv app geom (.convo-x geom) (.convo geom) h)
          0)
        (draw-new! cv app geom (.rail geom) (- w (.rail geom)) h))
    (draw-rail! cv app h)
    (draw-header! cv app geom split)
    0))

;; ---------------------------------------------------------------- hit testing
;;
;; These mirror the drawing above and take the same Panes, which is what keeps a
;; click and the thing it looks like it landed on from drifting apart when the
;; window is resized.

(defn rail-hit [(app (ptr App)) (y f64)] (-> i64)
  (let [n (al-len [Item] (.items app))
        (mut top) (+ HEADER 20.0)
        (mut i) 0
        (mut found) -1]
    (loop (if (or (>= (load i) n) (>= (load found) 0))
              (break)
              (let [it (al-elem [Item] (field app items) (load i))]
                (if (.head it)
                    (do
                      (when (> (load i) 0) (set! top (+ (load top) 14.0)) 0)
                      (set! top (+ (load top) 26.0))
                      0)
                    (do
                      (when (and (>= y (load top)) (< y (+ (load top) ROW)))
                        (set! found (load i))
                        0)
                      (set! top (+ (load top) ROW))
                      0))
                (set! i (+ (load i) 1)))))
    (load found)))

(defn node-hit [(app (ptr App)) (p (ptr Panes)) (px f64) (py f64)] (-> i64)
  (let [n (step-count app)
        x0 (+ (.rail p) 36.0)
        rows (+ 1 (max-row app))
        block (- (* ROW_GAP (cast f64 rows)) (- ROW_GAP NODE_H))
        y0 (+ HEADER (/ (- (- (- (.h p) HEADER) 42.0) block) 2.0))
        (mut i) 0
        (mut found) -1]
    (loop (if (or (>= (load i) n) (>= (load found) 0))
              (break)
              (let [s (step-at app (load i))
                    nx (node-x x0 (.col s))
                    ny (node-y y0 (.row s))]
                (when (and (and (>= px nx) (< px (+ nx NODE_W)))
                           (and (>= py ny) (< py (+ ny NODE_H))))
                  (set! found (load i))
                  0)
                (set! i (+ (load i) 1)))))
    (load found)))

;; The Run control is the only target in the header, and it exists only while
;; there is a plan that has not started.
(defn run-hit [(cv (ptr Canvas)) (app (ptr App)) (p (ptr Panes)) (px f64) (py f64)] (-> bool)
  (if (or (= (step-count app) 0) (started? app))
      false
      (let [label (join3 "Run " (dec-str (step-count app)) " steps")
            w (+ (text-width (field cv f11) label) 24.0)
            right (- (+ (.rail p) (.graph p)) GUTTER_PANE)]
        (and (and (>= px (- right w)) (< px right))
             (and (>= py 13.0) (< py 35.0))))))
