;; The three panes.
;;
;; Left: what exists. Middle: the shape of the one you picked. Right: the one
;; conversation you are reading. Every separation is a hairline; nothing is
;; filled except a selected row, and nothing is rounded.
(module coilgui.view)

(import "coil.alloc" :as alloc :use * :exclude [box!])
(import "coil.arraylist" :use *)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coilgui.ffi" :use *)
(import "coilgui.theme" :use *)
(import "coilgui.draw" :use *)
(import "coilgui.marks" :use *)
(import "coilgui.model" :use *)
(import "coilgui.util" :use *)

;; The pane geometry, derived from the window rather than declared. Drawing and
;; hit testing both take one of these, which is what keeps a click and the thing
;; it appears to be on from drifting apart when the window is resized.
(defstruct Panes [(w f64) (h f64) (rail f64) (graph f64) (convo-x f64) (convo f64)])

(defn panes [(w f64) (h f64)] (-> Panes)
  (let [p (primitive/alloc-stack Panes)
        rail RAIL_W
        wide (- w rail)
        ;; The conversation takes a share of what is left, within bounds: narrow
        ;; enough and the graph has no room, wide enough and prose stops wrapping
        ;; at a readable measure.
        convo
          (cond (< (* wide 0.42) 360.0) (if (< wide 720.0) (* wide 0.5) 360.0)
                (> (* wide 0.42) 620.0) 620.0
                :else (* wide 0.42))]
    (set! (field p w) w)
    (set! (field p h) h)
    (set! (field p rail) rail)
    (set! (field p graph) (- wide convo))
    (set! (field p convo-x) (+ rail (- wide convo)))
    (set! (field p convo) convo)
    (load p)))

(const COL_GAP 150.0)
(const ROW_GAP 64.0)

(defn state-color [(s State)] (-> Color)
  (match s
    (SQueued [] (ink3))
    (SRunning [] (amber))
    (SDone [] (green))
    (SFailed [] (red))
    (SAsks [] (amber))))

;; Every state mark in one place, so the graph and the rail can never drift.
(defn state-mark! [(cv (ptr Canvas)) (s State) (cx f64) (cy f64) (now f64)] (-> i64)
  (match s
    (SQueued [] (pending! cv cx cy (ink3)))
    (SRunning [] (spinner! cv cx cy 3.5 now (amber)))
    (SDone [] (check! cv cx cy (green)))
    (SFailed [] (cross! cv cx cy (red)))
    (SAsks [] (do (text-at! cv (field cv m12) (- cx 3.5) (+ cy 4.0) (amber) "?") 0))))

;; ---------------------------------------------------------------- rail

(defn draw-rail! [(cv (ptr Canvas)) (app (ptr App)) (h f64)] (-> i64)
  (let [n (al-len [Item] (.items app))
        (mut y) (+ HEADER 20.0)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [it (al-elem [Item] (field app items) (load i))
                    selected (= (load i) (.selected app))]
                (cond
                  ;; The library is not in the rail. It is drawn in the middle
                  ;; pane of a project, which is where running one happens, and
                  ;; one list of workflows is enough.
                  (item-library? it) 0
                  (item-workflow? it) 0
                  ;; A project heading is a row you can click: it is the place
                  ;; everything else acts in, so it selects like anything else.
                  (item-project? it)
                    (do
                      (when (> (load i) 0) (store! y (+ (load y) 16.0)) 0)
                      (when (and (not selected) (= (load i) (.hover-item app)))
                        (fill! cv 0.0 (load y) RAIL_W ROW (hover-wash))
                        0)
                      (when selected
                        (fill! cv 0.0 (load y) RAIL_W ROW (amber-wash))
                        (fill! cv 0.0 (load y) 2.0 ROW (amber))
                        0)
                      ;; A project heading is the brightest thing in the rail and
                      ;; everything under it is indented, so which project a row
                      ;; belongs to is legible without reading upward.
                      (text-elided! cv
                                    (field cv m12)
                                    GUTTER_RAIL
                                    (load y)
                                    ROW
                                    (- RAIL_W (* 2.0 GUTTER_RAIL))
                                    (if selected (ink1) (ink1))
                                    (.project it))
                      (set! y (+ (load y) ROW))
                      0)
                  ;; The library heading is structure, not a target.
                  (item-note? it)
                    (do
                      (text-elided! cv
                                    (field cv f11)
                                    (+ RAIL_INDENT 20.0)
                                    (load y)
                                    ROW
                                    170.0
                                    (line)
                                    (.name it))
                      (set! y (+ (load y) ROW))
                      0)
                  (item-heading? it)
                    (do
                      (store! y (+ (load y) 22.0))
                      (text-tracked! cv
                                     (field cv f11)
                                     GUTTER_RAIL
                                     (row-baseline (field cv f11) (load y) 22.0)
                                     (ink3)
                                     (.project it)
                                     1.4)
                      (set! y (+ (load y) 26.0))
                      0)
                  :else
                    (let [top (load y)
                          name (.name it)
                          ;; The open run reports live counts; every other row
                          ;; reports what its journal already says.
                          meta
                            (if (and (item-run? it) (= (.source it) (view-run app)))
                                (if (= (step-count app) 0)
                                    ""
                                    (join3 (dec-str (count-in-state app "done"))
                                           "/"
                                           (dec-str (step-count app))))
                                (.meta it))
                          st (.state it)]
                      (when (and (not selected) (= (load i) (.hover-item app)))
                        (fill! cv 0.0 top RAIL_W ROW (hover-wash))
                        0)
                      (when selected
                        (fill! cv 0.0 top RAIL_W ROW (amber-wash))
                        (fill! cv 0.0 top 2.0 ROW (amber))
                        0)
                      ;; Three marks for three kinds of thing: a run wears its
                      ;; state, an issue is an open square because nothing has
                      ;; run, and a workflow is a definition — a hollow chevron
                      ;; of nothing at all.
                      (cond (item-issue? it)
                              (do
                                (box! cv (+ RAIL_INDENT 1.5) (+ top (- (/ ROW 2.0) 3.5)) 7.0 7.0 (ink3))
                                0)
                            (item-workflow? it)
                              (do
                                (text-at! cv
                                          (field cv m12)
                                          (+ RAIL_INDENT 1.0)
                                          (+ top (+ (/ ROW 2.0) 4.0))
                                          (ink3)
                                          "›")
                                0)
                            :else
                              (state-mark! cv st (+ RAIL_INDENT 5.0) (+ top (/ ROW 2.0)) (.now app)))
                      (text-elided! cv
                                    (field cv f12)
                                    (+ RAIL_INDENT 20.0)
                                    top
                                    ROW
                                    ;; Everything the rail can spare: the mark,
                                    ;; the indent, and the count on the right.
                                    (- (- RAIL_W (+ RAIL_INDENT 20.0)) 64.0)
                                    (if selected (ink1) (if (= (state-word st) "done") (ink3) (ink2)))
                                    name)
                      (when (> (slice-len [u8] meta) 0)
                        (text-row! cv
                                   (field cv f11)
                                   (text-right (field cv f11) (- RAIL_W GUTTER_RAIL) meta)
                                   top
                                   ROW
                                   (ink3)
                                   meta)
                        0)
                      (set! y (+ (load y) ROW))
                      0))
                (set! i (+ (load i) 1)))))
    (hline! cv 0.0 (- h 42.0) RAIL_W (line))
    (text-row! cv (field cv f11) GUTTER_RAIL (- h 42.0) 42.0 (ink3) "⌘N workflow   ⌘I issue")
    (vline! cv (- RAIL_W HAIRLINE) 0.0 h (line))
    0))

;; ---------------------------------------------------------------- graph

(defn node-x [(x0 f64) (col i64)] (-> f64)
  (+ x0 (* COL_GAP (primitive/cast f64 col))))

(defn node-y [(y0 f64) (row i64)] (-> f64)
  (+ y0 (* ROW_GAP (primitive/cast f64 row))))

(defn draw-edge! [(cv (ptr Canvas))
                  (x0 f64)
                  (y0 f64)
                  (from (ptr Step))
                  (to (ptr Step))
                  (dashed bool)] (-> i64)
  (let [fx (+ (node-x x0 (.col from)) NODE_W)
        fy (+ (node-y y0 (.row from)) (/ NODE_H 2.0))
        tx (node-x x0 (.col to))
        ty (+ (node-y y0 (.row to)) (/ NODE_H 2.0))
        mid (+ fx 16.0)]
    (path! cv (line) dashed)
    (seg! cv fx fy mid fy)
    (seg! cv mid fy mid ty)
    (seg! cv mid ty tx ty)
    (end-path! cv)))

(defn draw-node! [(cv (ptr Canvas))
                  (x0 f64)
                  (y0 f64)
                  (s (ptr Step))
                  (focused bool)
                  (hot bool)
                  (now f64)] (-> i64)
  ;; No entrance animation. A node that is merely being shown must not move or
  ;; fade: reading is not an event. Only a state change is worth marking, and it
  ;; is marked in place.
  (let [settle (phase now (.changed s) ANIM_STEP)
        x (node-x x0 (.col s))
        y (node-y y0 (.row s))
        st (.state s)
        machine (.machine s)
        resting
          (if focused
              (amber)
              (if (= (state-word st) "queued") (line-quiet) (line)))
        ;; A step that just changed state flashes its border toward amber and
        ;; settles back, so the change is visible without anything moving.
        ;; ease-out(1) is exactly 1, so a settled node mixes to its resting
        ;; colour and no branch is needed.
        border (mix (amber) resting (ease-out settle))]
    (when hot (fill! cv x y NODE_W NODE_H (hover-wash)) 0)
    (box! cv x y NODE_W NODE_H border)
    (text-elided! cv
                  (field cv f12)
                  (+ x 12.0)
                  y
                  NODE_H
                  88.0
                  (if (= (state-word st) "queued") (ink3) (if (= (state-word st) "done") (ink2) (ink1)))
                  (.name s))
    (state-mark! cv st (+ x (- NODE_W 14.0)) (+ y (/ NODE_H 2.0)) now)
    (when (> (slice-len [u8] machine) 0)
      (hop! cv (+ x 12.0) (+ y (+ NODE_H 12.0)) (ink3))
      (text-at! cv (field cv f11) (+ x 24.0) (+ y (+ NODE_H 16.0)) (ink3) machine)
      0)
    0))

(defn max-row [(app (ptr App))] (-> i64)
  (let [n (step-count app)
        (mut i) 0
        (mut top) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [r (.row (step-at app (load i)))]
                (when (> r (load top)) (store! top r) 0)
                (set! i (+ (load i) 1)))))
    (load top)))

;; "" when the count is zero, so the footer lists only what is actually there.
(defn count-label [(n i64) (word (slice u8))] (-> (slice u8))
  (if (= n 0) "" (join2 (dec-str n) word)))

(defn foot-part! [(cv (ptr Canvas)) (x f64) (top f64) (c Color) (label (slice u8)) (first bool)] (-> f64)
  (if (= (slice-len [u8] label) 0)
      x
      (let [at (if first x (+ x 14.0))]
        (when (not first)
          (text-row! cv (field cv f11) x top 42.0 (line) "·")
          0)
        (+ at (+ (text-row! cv (field cv f11) at top 42.0 c label) 4.0)))))

(defn draw-graph! [(cv (ptr Canvas)) (app (ptr App)) (p (ptr Panes)) (x f64) (w f64) (h f64)] (-> i64)
  (let [n (step-count app)
        x0 (+ x 36.0)
        rows (+ 1 (max-row app))
        block (- (* ROW_GAP (primitive/cast f64 rows)) (- ROW_GAP NODE_H))
        y0 (+ HEADER (/ (- (- (- h HEADER) 42.0) block) 2.0))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [s (step-at app (load i))
                    from (.from s)
                    join (.join s)]
                (when (>= from 0)
                  (draw-edge! cv
                              x0
                              y0
                              (step-at app from)
                              s
                              (> (slice-len [u8] (.machine s)) 0))
                  0)
                (when (>= join 0)
                  (draw-edge! cv x0 y0 (step-at app join) s false)
                  0)
                (set! i (+ (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) n)
              (break)
              (do
                (draw-node! cv
                            x0
                            y0
                            (step-at app (load i))
                            (and (started? app) (= (load i) (.focus app)))
                            (= (load i) (.hover-node app))
                            (.now app))
                (set! i (+ (load i) 1)))))
    (hline! cv x (- h 42.0) w (line))
    (let [(mut lx) (+ x GUTTER_PANE)
          foot-top (- h 42.0)]
      (if (= n 0)
          (do (text-row! cv (field cv f11) (load lx) foot-top 42.0 (ink3) "no steps yet") 0)
          (do
            (set! lx
                  (foot-part! cv
                              (load lx)
                              foot-top
                              (ink3)
                              (join2 (dec-str n) (if (= n 1) " step" " steps"))
                              true))
            (set! lx
                  (foot-part! cv
                              (load lx)
                              foot-top
                              (green)
                              (count-label (count-in-state app "done") " done")
                              false))
            (set! lx
                  (foot-part! cv
                              (load lx)
                              foot-top
                              (amber)
                              (count-label (count-in-state app "running") " running")
                              false))
            (set! lx
                  (foot-part! cv
                              (load lx)
                              foot-top
                              (amber)
                              (count-label (count-in-state app "asks") " waiting on you")
                              false))
            (set! lx
                  (foot-part! cv
                              (load lx)
                              foot-top
                              (red)
                              (count-label (count-in-state app "failed") " failed")
                              false))
            (set! lx
                  (foot-part! cv
                              (load lx)
                              foot-top
                              (ink3)
                              (count-label (count-in-state app "queued") " queued")
                              false))
            0)))
    (vline! cv (- (+ x w) HAIRLINE) 0.0 h (line))
    0))

;; ------------------------------------------------------------- run something

;; With a project open, the middle pane is the question that project poses:
;; what do you want to run here. The rows are the library, drawn from the same
;; items the rail is built from, so there is one list of workflows and not two.
(defn picker-top [] (-> f64) (+ HEADER 44.0))

;; The middle pane is a list of things to pick when what is open poses a
;; question: a project asks which workflow, and a workflow that needs an issue
;; asks which issue.
(defn picker-wants-issues? [(app (ptr App))] (-> bool)
  (or (>= (view-workflow app) 0) (issue-composer? app)))

(defn picker-row? [(app (ptr App)) (it (ptr Item))] (-> bool)
  (if (picker-wants-issues? app) (item-issue? it) (item-workflow? it)))

(defn draw-picker! [(cv (ptr Canvas)) (app (ptr App)) (x f64) (w f64) (h f64)] (-> i64)
  (let [n (al-len [Item] (.items app))
        (mut y) (picker-top)
        (mut shown) 0
        (mut i) 0]
    (text-tracked! cv
                   (field cv f11)
                   (+ x GUTTER_PANE)
                   (row-baseline (field cv f11) (+ HEADER 14.0) 22.0)
                   (ink3)
                   (cond (issue-composer? app) "the backlog"
                         (picker-wants-issues? app) "run it on one of these"
                         :else "run a workflow here")
                   1.4)
    (loop (if (>= (load i) n)
              (break)
              (let [it (al-elem [Item] (field app items) (load i))]
                (when (picker-row? app it)
                  (let [top (load y)
                        hot (= (load i) (.hover-node app))]
                    (when hot (fill! cv x top w ROW (hover-wash)) 0)
                    (text-at! cv (field cv m12) (+ x GUTTER_PANE) (+ top (+ (/ ROW 2.0) 4.0)) (ink3) "›")
                    (text-elided! cv
                                  (field cv f13)
                                  (+ x (+ GUTTER_PANE 20.0))
                                  top
                                  ROW
                                  (- w 160.0)
                                  (ink1)
                                  (.name it))
                    (text-row! cv
                               (field cv f11)
                               (text-right (field cv f11) (- (+ x w) GUTTER_PANE) (.meta it))
                               top
                               ROW
                               (ink3)
                               (.meta it))
                    (set! y (+ (load y) ROW))
                    (store! shown (+ (load shown) 1))
                    0))
                (set! i (+ (load i) 1)))))
    (hline! cv x (- h 42.0) w (line))
    (text-row! cv
               (field cv f11)
               (+ x GUTTER_PANE)
               (- h 42.0)
               42.0
               (ink3)
               (cond (and (picker-wants-issues? app) (= (load shown) 0))
                       "no issues in this project yet · ⌘I writes one"
                     (picker-wants-issues? app) "⌘I writes a new one"
                     (= (load shown) 0) "no workflows yet · ⌘N writes one"
                     :else "⌘N writes a new one"))
    (vline! cv (- (+ x w) HAIRLINE) 0.0 h (line))
    0))

;; Which workflow row the pointer is over, as an index into the app's items so a
;; click can open it through the same path the rail uses.
(defn picker-hit [(app (ptr App)) (p (ptr Panes)) (px f64) (py f64)] (-> i64)
  (if (or (< px (.rail p)) (>= px (.convo-x p)))
      -1
      (let [n (al-len [Item] (.items app))
            (mut y) (picker-top)
            (mut i) 0
            (mut found) -1]
        (loop (if (or (>= (load i) n) (>= (load found) 0))
                  (break)
                  (let [it (al-elem [Item] (field app items) (load i))]
                    (when (picker-row? app it)
                      (when (and (>= py (load y)) (< py (+ (load y) ROW)))
                        (set! found (load i))
                        0)
                      (set! y (+ (load y) ROW))
                      0)
                    (set! i (+ (load i) 1)))))
        (load found))))

;; ---------------------------------------------------------------- conversation

(defn draw-line-reset! [(cv (ptr Canvas)) (v f64)] (-> f64)
  (canvas-alpha! cv 1.0)
  v)

;; Where a line's own text starts, which is not the same for every speaker: a
;; result is indented under its tool call, and a continuation lines up with the
;; body above it.
(defn line-left [(l (ptr Line)) (x f64)] (-> f64)
  (match (.who l) (Result [] (+ x 34.0)) (_ (+ x 20.0))))

(defn line-face [(cv (ptr Canvas)) (l (ptr Line))] (-> (ptr Face))
  (match (.who l) (Tool [] (field cv m13)) (_ (field cv f13))))

;; The selection, painted behind the glyphs of one line. Every face here is
;; fixed-pitch, so a character is an offset and a width rather than a measurement.
(defn draw-selection! [(cv (ptr Canvas)) (app (ptr App)) (l (ptr Line)) (at i64) (top f64)] (-> i64)
  (if (or (not (sel-active? app))
          (or (< at (sel-first-line app)) (> at (sel-last-line app))))
      0
      (let [cells (text-cells (.text l))
            from (if (= at (sel-first-line app)) (sel-first-cell app) 0)
            to (if (= at (sel-last-line app)) (sel-last-cell app) cells)
            lo (if (< from 0) 0 (if (> from cells) cells from))
            hi (if (< to lo) lo (if (> to cells) cells to))
            adv (.adv l)
            left (.left l)]
        (if (or (<= (- hi lo) 0) (<= adv 0.0))
            0
            (fill! cv
                   (+ left (* adv (primitive/cast f64 lo)))
                   top
                   (* adv (primitive/cast f64 (- hi lo)))
                   LINE_H
                   (select-wash))))))

(defn draw-line! [(cv (ptr Canvas))
                  (app (ptr App))
                  (l (ptr Line))
                  (at i64)
                  (x f64)
                  (w f64)
                  (top-in f64)] (-> f64)
  (let [top top-in
        text (.text l)
        trail (.trail l)
        body-x (line-left l x)
        room (- (- w 40.0) 20.0)]
    ;; Record what is about to be drawn, so a click can find the character it
    ;; landed on without a second copy of the layout.
    (set! (.top l) top)
    (set! (.left l) body-x)
    (set! (.adv l) (.adv (line-face cv l)))
    (draw-selection! cv app l at top)
    (draw-line-reset! cv
                      (match (.who l)
                        (You []
                             (do
                               (caret! cv (+ x 4.0) (+ top (/ LINE_H 2.0)) (amber))
                               (text-elided! cv (field cv f13) body-x top LINE_H room (ink1) text)
                               (+ top LINE_H)))
                        (Agent []
                               (do
                                 (dot! cv (+ x 4.0) (+ top (/ LINE_H 2.0)) 2.6 (ink1))
                                 (text-elided! cv (field cv f13) body-x top LINE_H room (ink2) text)
                                 (+ top LINE_H)))
                        (Cont []
                              (do
                                (text-elided! cv (field cv f13) body-x top LINE_H room (ink2) text)
                                (+ top LINE_H)))
                        (Tool []
                              (do
                                (ring! cv (+ x 4.0) (+ top (/ LINE_H 2.0)) 3.0 (ink3))
                                (text-elided! cv (field cv m13) body-x top LINE_H (- room 90.0) (ink1) text)
                                (when (> (slice-len [u8] trail) 0)
                                  (text-row! cv
                                             (field cv f11)
                                             (text-right (field cv f11) (- (+ x w) GUTTER_PANE) trail)
                                             top
                                             LINE_H
                                             (green)
                                             trail)
                                  0)
                                (+ top LINE_H)))
                        (Result []
                                (do
                                  (elbow! cv (+ x 22.0) (+ top (/ LINE_H 2.0)) (ink3))
                                  (text-elided! cv (field cv f13) body-x top LINE_H (- room 14.0) (ink3) text)
                                  (+ top LINE_H)))
                        (Pending []
                                 (do
                                   (fill! cv x top 2.0 (* LINE_H 2.0) (line))
                                   (caret! cv (+ x 14.0) (+ top (/ LINE_H 2.0)) (amber))
                                   (text-elided! cv (field cv f13) (+ x 28.0) top LINE_H (- room 28.0) (ink2) text)
                                   (text-row! cv
                                              (field cv f11)
                                              (+ x 28.0)
                                              (+ top LINE_H)
                                              LINE_H
                                              (ink3)
                                              "queued · delivered at the next turn boundary")
                                   (+ top (* LINE_H 2.0))))
                        (Asks []
                              (do
                                (text-at! cv (field cv m13) (+ x 1.0) (+ top 15.0) (amber) "?")
                                (text-elided! cv (field cv f13) body-x top LINE_H room (amber) text)
                                (+ top LINE_H)))))))

;; The composer wraps and grows.
;;
;; It used to be one line that elided: what you typed disappeared off the right
;; while you were still typing it, which is no way to write a paragraph to
;; somebody. Now it wraps at the pane's measure and grows upward, and the
;; conversation above it moves up to make room.
(const COMPOSER_PAD 18.0)
(const COMPOSER_MAX_ROWS 8)

;; How many characters fit on one row of the composer.
(defn composer-columns [(cv (ptr Canvas)) (w f64)] (-> i64)
  (let [room (- w (+ (* 2.0 GUTTER_PANE) 40.0))
        adv (.adv (field cv f13))
        columns (cast i64 (/ room adv))]
    (if (< columns 8) 8 columns)))

;; Where each row of the input starts, walking the text once: newlines break, and
;; a row that fills up breaks at the last space before the edge.
(defn composer-row-end [(text (slice u8)) (from i64) (columns i64)] (-> i64)
  (let [n (slice-len [u8] text)
        hard (+ from (prefix-bytes (subslice [u8] text from n) columns))
        (mut at) from
        (mut stop) -1]
    ;; A newline always ends the row.
    (loop (if (or (>= (load at) hard) (>= (load stop) 0))
              (break)
              (do
                (when (= (cast i64 (slice-get [u8] text (load at))) 10)
                  (store! stop (load at))
                  0)
                (set! at (+ (load at) 1)))))
    (if (>= (load stop) 0)
        (load stop)
        (if (>= hard n)
            n
            ;; Break at the last space that fits, so a word is not cut in half.
            (let [(mut back) hard]
              (loop (if (or (<= (load back) from)
                            (= (cast i64 (slice-get [u8] text (- (load back) 1))) 32))
                        (break)
                        (set! back (- (load back) 1))))
              (if (> (load back) from) (load back) hard))))))

(defn composer-rows [(cv (ptr Canvas)) (text (slice u8)) (w f64)] (-> i64)
  (let [n (slice-len [u8] text)
        columns (composer-columns cv w)
        (mut at) 0
        (mut rows) 0]
    (loop (if (or (>= (load at) n) (>= (load rows) COMPOSER_MAX_ROWS))
              (break)
              (let [stop (composer-row-end text (load at) columns)]
                (set! rows (+ (load rows) 1))
                (set! at (if (>= stop n)
                             n
                             (if (= (cast i64 (slice-get [u8] text stop)) 10)
                                 (+ stop 1)
                                 stop))))))
    (if (< (load rows) 1) 1 (load rows))))

;; The strip's height for the text it currently holds. Everything that lays out
;; the conversation asks this rather than assuming one line.
(defn composer-height [(cv (ptr Canvas)) (app (ptr App)) (w f64)] (-> f64)
  (+ 34.0 (* LINE_H (cast f64 (composer-rows cv (al-slice [u8] (.input app)) w)))))

(defn draw-composer! [(cv (ptr Canvas))
                      (app (ptr App))
                      (x f64)
                      (w f64)
                      (h f64)
                      (hint (slice u8))
                      (placeholder (slice u8))] (-> i64)
  (let [height (composer-height cv app w)
        top (- h height)
        text (al-slice [u8] (.input app))
        base (+ x GUTTER_PANE)
        empty (= (slice-len [u8] text) 0)
        ;; A click here, or a keystroke, makes the composer the active target.
        ;; Typing has always gone to this line whether or not you clicked it;
        ;; keep the confirmation visible instead of letting it disappear after
        ;; the short feedback animation. `composer-lit` is a persistent marker;
        ;; the zero blend amount keeps the active wash fully amber.
        active (> (.composer-lit app) 0.0)
        lit 0.0]
    ;; Keep this separate from the old transient feedback timing: once the
    ;; composer has been activated, its visual confirmation must not fade out.
    (when active (fill! cv x top w height (mix (amber-wash) (ground) lit)) 0)
    ;; The rule above the composer brightens with it, so the whole strip reads as
    ;; one thing rather than a line with a cursor loose beneath it. Two pixels
    ;; while it is lit: a hairline that changes colour is not a change anyone
    ;; sees at the bottom of a window they are not looking at yet.
    (if active
        (fill! cv x top w 2.0 (mix (amber) (line) lit))
        (hline! cv x top w (line)))
    (caret! cv (+ base 4.0) (+ top 26.0) (amber))
    (if empty
        (do
          ;; The placeholder starts past the cursor rather than under it.
          (text-row! cv (field cv f13) (+ base 36.0) top 52.0 (line) placeholder)
          (fill! cv (+ base 20.0) (+ top 18.0) 8.0 16.0 (amber))
          0)
        ;; Every row of what you typed, wrapped at the measure, with the cursor
        ;; after the last character rather than after the last row.
        (let [n (slice-len [u8] text)
              columns (composer-columns cv w)
              (mut at) 0
              (mut row) 0
              (mut cursor-x) (+ base 20.0)
              (mut cursor-y) (+ top COMPOSER_PAD)]
          (loop (if (or (>= (load at) n) (>= (load row) COMPOSER_MAX_ROWS))
                    (break)
                    (let [stop (composer-row-end text (load at) columns)
                          line-text (subslice [u8] text (load at) (if (> stop n) n stop))
                          y (+ top (+ COMPOSER_PAD (* LINE_H (cast f64 (load row)))))
                          width (text-at! cv (field cv f13) (+ base 20.0) (+ y 15.0) (ink1) line-text)]
                      (set! cursor-x (+ (+ base 20.0) width))
                      (set! cursor-y y)
                      (set! row (+ (load row) 1))
                      (set! at (if (>= stop n)
                                   n
                                   (if (= (cast i64 (slice-get [u8] text stop)) 10)
                                       (+ stop 1)
                                       stop))))))
          ;; A trailing newline puts the cursor on the next row, where the next
          ;; character will actually go.
          (when (and (> n 0) (= (cast i64 (slice-get [u8] text (- n 1))) 10))
            (set! cursor-x (+ base 20.0))
            (set! cursor-y (+ (load cursor-y) LINE_H))
            0)
          (fill! cv (load cursor-x) (+ (load cursor-y) 2.0) 8.0 16.0 (amber))
          0))
    ;; The hint is the first thing to go when the pane is narrow: it is a
    ;; reminder, and the thing you are typing is not.
    (when (and (> (slice-len [u8] hint) 0)
               (> w (+ 260.0 (text-width (field cv f11) hint))))
      (text-row! cv
                 (field cv f11)
                 (text-right (field cv f11) (- (+ x w) GUTTER_PANE) hint)
                 (- h 34.0)
                 34.0
                 (ink3)
                 hint)
      0)
    0))

(defn line-height [(l (ptr Line))] (-> f64)
  (match (.who l)
    (Pending [] (* LINE_H 2.0))
    (_ LINE_H)))

;; The conversation is anchored to the bottom, like a terminal: a replayed run
;; is hundreds of lines and the part worth reading is the end of it. When it
;; fits, it sits at the top as normal.
(defn draw-convo! [(cv (ptr Canvas)) (app (ptr App)) (p (ptr Panes)) (x f64) (w f64) (h f64)] (-> i64)
  ;; What a line can hold here, measured, so whatever builds lines wraps them to
  ;; the width they will actually be drawn at.
  (set! (.wrap-cols app)
        (cast i64 (/ (- (- w GUTTER_PANE) 60.0) (.adv (field cv f13)))))
  (let [n (al-len [Line] (.lines app))
        top (+ HEADER 22.0)
        bottom (- h (+ (composer-height cv app w) 14.0))
        room (- bottom top)
        (mut total) 0.0
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [l (al-elem [Line] (field app lines) (load i))
                    follows
                      (if (>= (+ (load i) 1) n)
                          false
                          (match (.who (al-elem [Line] (field app lines) (+ (load i) 1)))
                            (Cont [] true)
                            (_ false)))]
                (set! total (+ (load total) (+ (line-height l) (if follows 0.0 8.0))))
                (set! i (+ (load i) 1)))))
    ;; Publish how far back there is to go, so the wheel has something to clamp
    ;; against, and clamp the current position in case the content shrank.
    (set! (.scroll-max app) (if (> (load total) room) (- (load total) room) 0.0))
    ;; Content arrived while the reader was back in the history: move with it, so
    ;; the lines under their eyes stay under their eyes. Pinned to the end (0)
    ;; means stay pinned, which is what a live run wants.
    (when (>= (.anchor app) 0.0)
      (when (> (.scroll app) 0.0)
        (set! (.scroll app) (+ (.scroll app) (- (.scroll-max app) (.anchor app))))
        0)
      (set! (.anchor app) -1.0)
      0)
    (when (> (.scroll app) (.scroll-max app))
      (set! (.scroll app) (.scroll-max app))
      0)
    (when (< (.scroll app) 0.0) (set! (.scroll app) 0.0) 0)
    (let [(mut y)
            (if (< (load total) room)
                top
                (+ (- bottom (load total)) (.scroll app)))]
      (let [(mut k) 0]
        (loop (if (>= (load k) n)
                  (break)
                  (do
                    (set! (.top (al-elem [Line] (field app lines) (load k))) -1.0)
                    (set! k (+ (load k) 1))))))
      (clip-push! cv x HEADER w (- (- h HEADER) (composer-height cv app w)))
      (set! i 0)
      (loop (if (>= (load i) n)
                (break)
                (let [l (al-elem [Line] (field app lines) (load i))
                      next (draw-line! cv app l (load i) (+ x GUTTER_PANE) (- w GUTTER_PANE) (load y))
                      follows
                        (if (>= (+ (load i) 1) n)
                            false
                            (match (.who (al-elem [Line] (field app lines) (+ (load i) 1)))
                              (Cont [] true)
                              (_ false)))]
                  (set! y (if follows next (+ next 8.0)))
                  (set! i (+ (load i) 1)))))
      (clip-pop! cv)
      ;; A hairline gutter mark, only while there is history above to reach.
      (when (> (.scroll-max app) 0.0)
        (let [track (- bottom top)
              ;; The thumb's length is the visible share of the whole
              ;; conversation, and its position is how far back you are.
              thumb
                (let [share (/ room (load total))
                      size (* track share)]
                  (if (< size 24.0) 24.0 size))
              travel (- track thumb)
              back (/ (.scroll app) (.scroll-max app))]
          (fill! cv (- (+ x w) 3.0) (+ top (* travel (- 1.0 back))) 2.0 thumb (line))
          0))
      0)
    (draw-composer! cv
                    app
                    x
                    w
                    h
                    ;; No hint here. The composer says what it is for in its own
                    ;; placeholder; a second sentence beside it was noise.
                    ""
                    (cond (>= (view-issue app) 0) "filed · press Run"
                          (>= (view-workflow app) 0) "a definition"
                          (>= (view-project app) 0) "⌘I files an issue here"
                          (and (>= (view-run app) 0) (> (count-in-state app "running") 0))
                            "say something to the agent working now · ⇧⏎ for a new line"
                          (>= (view-run app) 0) "carry it on — this starts another run here"
                          :else "message"))
    0))

;; What the Run control says, in one place, because the label, the target it
;; hit-tests against, and whether there is a button at all must all be the same
;; decision. "" means there is nothing to run from here.
;;
;; A workflow runs *in* the current project, so the button names it. An issue is
;; already filed in one, so it does not.
(defn run-label [(app (ptr App))] (-> (slice u8))
  (cond (= (slice-len [u8] (.project-label app)) 0) ""
        ;; A workflow that works on an issue has no Run of its own: the pane
        ;; below asks which issue, and running is what you do to the pair.
        (needs-input? app) ""
        (>= (view-workflow app) 0) (join2 "Run in " (.project-label app))
        (>= (view-issue app) 0) "Run this issue"
        :else ""))

;; The other control in the header, and the only destructive one in the window.
(defn stop-label [(app (ptr App))] (-> (slice u8))
  (if (.can-stop app) "Stop" ""))

(defn run-button! [(cv (ptr Canvas)) (right f64) (top f64) (label (slice u8)) (hot bool)] (-> f64)
  (let [w (+ (text-width (field cv f11) label) 24.0)
        x (- right w)
        y (+ top 13.0)]
    (when hot (fill! cv x y w 22.0 (amber-wash)) 0)
    (box! cv x y w 22.0 (amber))
    (text-row! cv (field cv f11) (+ x 12.0) y 22.0 (amber) label)
    x))

(defn draw-header! [(cv (ptr Canvas)) (app (ptr App)) (p (ptr Panes)) (split bool)] (-> i64)
  (let [n (step-count app)
        label (run-label app)
        title (.title app)
        w (.w p)
        graph-w (.graph p)]
    (hline! cv 0.0 (- HEADER HAIRLINE) w (line))
    (text-row! cv (field cv m13) GUTTER_RAIL 0.0 HEADER (ink1) "coil")
    (text-row! cv
               (field cv f11)
               (text-right (field cv f11) (- (.rail p) GUTTER_RAIL) "⌘K")
               0.0
               HEADER
               (ink3)
               "⌘K")
    (if (not split)
        (do (text-row! cv (field cv f13) (+ (.rail p) GUTTER_PANE) 0.0 HEADER (ink3) title) 0)
        (let [mid-right (+ (.rail p) graph-w)]
          (text-elided! cv (field cv m13) (+ (.rail p) GUTTER_PANE) 0.0 HEADER (- graph-w 200.0) (ink1) title)
          (if (> (slice-len [u8] label) 0)
              (do (run-button! cv (- mid-right GUTTER_PANE) 0.0 label (.hover-run app)) 0)
              (when (and (>= (view-run app) 0) (> n 0))
                (text-row! cv
                           (field cv f11)
                           (text-right (field cv f11)
                                       (- mid-right GUTTER_PANE)
                                       (join3 (dec-str (count-in-state app "done")) "/" (dec-str n)))
                           0.0
                           HEADER
                           (ink3)
                           (join3 (dec-str (count-in-state app "done")) "/" (dec-str n)))
                0))
          ;; The right pane names what it is showing and, beside it, the one
          ;; fact that matters about it.
          (let [reading
                  (cond (>= (view-run app) 0) (if (> n 0) (.name (step-at app (.focus app))) "run")
                        (>= (view-workflow app) 0) "workflow"
                        (>= (view-issue app) 0) "issue"
                        (>= (view-project app) 0) "project"
                        :else "")
                aside
                  (cond (>= (view-run app) 0)
                          (if (> n 0)
                              (let [st (.state (step-at app (.focus app)))]
                                (if (= (state-word st) "asks") "waiting on you" (state-word st)))
                              "")
                        (needs-input? app) "needs an issue"
                        (>= (view-workflow app) 0) "has not run here"
                        (>= (view-issue app) 0) (.project-label app)
                        (>= (view-project app) 0) "everything that ran here"
                        :else "")
                tint
                  (if (and (>= (view-run app) 0) (> n 0))
                      (state-color (.state (step-at app (.focus app))))
                      (ink3))]
            (text-elided! cv
                          (field cv m13)
                          (+ mid-right GUTTER_PANE)
                          0.0
                          HEADER
                          220.0
                          (ink1)
                          reading)
            ;; Stop, or what is going on, in the same corner: a run that can be
            ;; stopped is one you are watching, and the two never both apply.
            (if (> (slice-len [u8] (stop-label app)) 0)
                (do
                  (run-button! cv (- w GUTTER_PANE) 0.0 (stop-label app) (.hover-run app))
                  0)
                (when (> (slice-len [u8] aside) 0)
                  (text-row! cv
                             (field cv f11)
                             (text-right (field cv f11) (- w GUTTER_PANE) aside)
                             0.0
                             HEADER
                             tint
                             aside)
                  0))
            0)
          0))
    0))

;; ---------------------------------------------------------------- empty state

;; A new workflow is one prompt in the middle of the window. The panes appear
;; when there is something to put in them, not before.
(defn draw-new! [(cv (ptr Canvas)) (app (ptr App)) (p (ptr Panes)) (x f64) (w f64) (h f64)] (-> i64)
  (let [box-w 620.0
        left (+ x (/ (- w box-w) 2.0))
        top (- (/ h 2.0) 110.0)
        text (al-slice [u8] (.input app))
        empty (= (slice-len [u8] text) 0)]
    (text-row! cv
               (field cv f12)
               left
               top
               22.0
               (ink3)
               (if (issue-composer? app)
                   "talk about what is wrong. an agent reads the project and writes the issues."
                   "describe what should happen. an agent designs the workflow and writes it."))
    (caret! cv (+ left 5.0) (+ top 62.0) (amber))
    (let [tw
            (text-elided! cv
                          (field cv f13)
                          (+ left 20.0)
                          (+ top 50.0)
                          24.0
                          (- box-w 40.0)
                          (if empty (line) (ink1))
                          (if empty
                              (if (issue-composer? app) "what is going wrong?" "what should this do?")
                              text))]
      (when (not empty)
        (fill! cv (+ (+ left 22.0) tw) (+ top 55.0) 8.0 16.0 (amber))
        0))
    (hline! cv left (+ top 82.0) box-w (line))
    (text-row! cv (field cv f11) left (+ top 92.0) 22.0 (ink3) "⏎ send · ⇧⏎ newline")
    (text-row! cv
               (field cv f11)
               left
               (+ top 114.0)
               22.0
               (ink3)
               (if (issue-composer? app)
                   (join2 "backlog for " (.project-label app))
                   "a workflow belongs to no project; you choose one when you run it"))
    0))

;; ---------------------------------------------------------------- whole window

(defn draw-app! [(cv (ptr Canvas)) (app (ptr App)) (w f64) (h f64)] (-> i64)
  ;; The one-prompt screen belongs to a composer with nothing in it yet. The
  ;; moment there is a conversation -- what you said, what the agent is doing --
  ;; it has to be on screen, or sending reads as the text box clearing and
  ;; nothing happening.
  (let [split (or (not (view-nothing? app)) (> (al-len [Line] (.lines app)) 0))
        geom (primitive/alloc-stack Panes)]
    (set! geom (panes w h))
    (fill! cv 0.0 0.0 w h (ground))
    (if split
        (do
          (if (or (>= (view-project app) 0)
                  (or (needs-input? app) (issue-composer? app)))
              (draw-picker! cv app (.rail geom) (.graph geom) h)
              (draw-graph! cv app geom (.rail geom) (.graph geom) h))
          (draw-convo! cv app geom (.convo-x geom) (.convo geom) h)
          0)
        (draw-new! cv app geom (.rail geom) (- w (.rail geom)) h))
    (draw-rail! cv app h)
    (draw-header! cv app geom split)
    0))

;; The line under a point, or -1. Lines carry the rect they were last drawn in,
;; so this answers about what is on screen rather than about the layout rules.
;; A line is only hit-testable where it is actually visible. The conversation is
;; drawn into a clip that starts below the header, so lines scrolled up sit at
;; coordinates behind it: real positions, nothing you can see or point at.
(defn line-visible? [(l (ptr Line))] (-> bool)
  (>= (.top l) HEADER))

(defn convo-line-at [(app (ptr App)) (py f64)] (-> i64)
  (let [n (al-len [Line] (.lines app))
        (mut i) 0
        (mut found) -1]
    (loop (if (or (>= (load i) n) (>= (load found) 0))
              (break)
              (let [l (al-elem [Line] (field app lines) (load i))]
                (when (and (line-visible? l)
                           (and (>= py (.top l)) (< py (+ (.top l) LINE_H))))
                  (set! found (load i))
                  0)
                (set! i (+ (load i) 1)))))
    (load found)))

;; The character of that line under a point, clamped to its ends: a drag that
;; runs off the right of a line selects to the end of it, which is what dragging
;; through text does everywhere else.
(defn convo-cell-at [(app (ptr App)) (at i64) (px f64)] (-> i64)
  (let [l (al-elem [Line] (field app lines) at)
        cells (text-cells (.text l))
        adv (.adv l)]
    (if (<= adv 0.0)
        0
        (let [over (/ (- px (.left l)) adv)
              cell (cast i64 (+ over 0.5))]
          (if (< cell 0) 0 (if (> cell cells) cells cell))))))

;; The line nearest a point above or below everything drawn, so a drag that
;; leaves the pane keeps selecting instead of stopping.
(defn convo-line-near [(app (ptr App)) (py f64)] (-> i64)
  (let [n (al-len [Line] (.lines app))
        (mut i) 0
        (mut first-drawn) -1
        (mut last-drawn) -1]
    (loop (if (>= (load i) n)
              (break)
              (let [l (al-elem [Line] (field app lines) (load i))]
                (when (line-visible? l)
                  (when (< (load first-drawn) 0) (set! first-drawn (load i)) 0)
                  (set! last-drawn (load i))
                  0)
                (set! i (+ (load i) 1)))))
    (if (< (load first-drawn) 0)
        -1
        (if (< py (.top (al-elem [Line] (field app lines) (load first-drawn))))
            (load first-drawn)
            (load last-drawn)))))

;; ---------------------------------------------------------------- hit testing
;;
;; These mirror the drawing above and take the same Panes, which is what keeps a
;; click and the thing it looks like it landed on from drifting apart when the
;; window is resized.

(defn rail-hit [(app (ptr App)) (y f64)] (-> i64)
  (let [n (al-len [Item] (.items app))
        (mut top) (+ HEADER 20.0)
        (mut i) 0
        (mut found) -1]
    (loop (if (or (>= (load i) n) (>= (load found) 0))
              (break)
              (let [it (al-elem [Item] (field app items) (load i))]
                (cond (item-library? it) 0
                      (item-workflow? it) 0
                      (item-project? it)
                        (do
                          (when (> (load i) 0) (set! top (+ (load top) 16.0)) 0)
                          (when (and (>= y (load top)) (< y (+ (load top) ROW)))
                            (set! found (load i))
                            0)
                          (set! top (+ (load top) ROW))
                          0)
                      (item-note? it) (do (set! top (+ (load top) ROW)) 0)
                      (item-heading? it) (do (set! top (+ (load top) 48.0)) 0)
                      :else
                        (do
                          (when (and (>= y (load top)) (< y (+ (load top) ROW)))
                            (set! found (load i))
                            0)
                          (set! top (+ (load top) ROW))
                          0))
                (set! i (+ (load i) 1)))))
    (load found)))

(defn node-hit [(app (ptr App)) (p (ptr Panes)) (px f64) (py f64)] (-> i64)
  (let [n (step-count app)
        x0 (+ (.rail p) 36.0)
        rows (+ 1 (max-row app))
        block (- (* ROW_GAP (cast f64 rows)) (- ROW_GAP NODE_H))
        y0 (+ HEADER (/ (- (- (- (.h p) HEADER) 42.0) block) 2.0))
        (mut i) 0
        (mut found) -1]
    (loop (if (or (>= (load i) n) (>= (load found) 0))
              (break)
              (let [s (step-at app (load i))
                    nx (node-x x0 (.col s))
                    ny (node-y y0 (.row s))]
                (when (and (and (>= px nx) (< px (+ nx NODE_W)))
                           (and (>= py ny) (< py (+ ny NODE_H))))
                  (set! found (load i))
                  0)
                (set! i (+ (load i) 1)))))
    (load found)))

;; The Run control is the only target in the header, and it exists only while
;; there is a plan that has not started.
;; Both header controls sit in the same place, so they are hit-tested the same
;; way and only one of them exists at a time.
(defn header-button-hit [(cv (ptr Canvas))
                         (app (ptr App))
                         (p (ptr Panes))
                         (label (slice u8))
                         (px f64)
                         (py f64)] (-> bool)
  (if (= (slice-len [u8] label) 0)
      false
      (let [w (+ (text-width (field cv f11) label) 24.0)
            right (- (+ (.rail p) (.graph p)) GUTTER_PANE)]
        (and (and (>= px (- right w)) (< px right))
             (and (>= py 13.0) (< py 35.0))))))

;; Stop lives in the right-hand pane's header, beside the transcript it is going
;; to interrupt -- that is where you are looking when you decide to stop it.
(defn stop-hit [(cv (ptr Canvas)) (app (ptr App)) (p (ptr Panes)) (px f64) (py f64)] (-> bool)
  (let [label (stop-label app)]
    (if (= (slice-len [u8] label) 0)
        false
        (let [w (+ (text-width (field cv f11) label) 24.0)
              right (- (.w p) GUTTER_PANE)]
          (and (and (>= px (- right w)) (< px right))
               (and (>= py 13.0) (< py 35.0)))))))

(defn run-hit [(cv (ptr Canvas)) (app (ptr App)) (p (ptr Panes)) (px f64) (py f64)] (-> bool)
  (if (> (slice-len [u8] (stop-label app)) 0)
      false
      (let [label (run-label app)
            w (+ (text-width (field cv f11) label) 24.0)
            right (- (+ (.rail p) (.graph p)) GUTTER_PANE)]
        (and (and (>= px (- right w)) (< px right))
             (and (>= py 13.0) (< py 35.0))))))
