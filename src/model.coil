;; Application state.
;;
;; One workflow is a list of steps plus the conversation that produced them, and
;; those are the same object: talking is how the graph changes. Layout is derived
;; from the dependencies rather than stored, so a step added mid-conversation
;; lands in the right column without anyone placing it.
(module coilgui.model)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use *)
(import "coil.str" :use *)

(defsum State (SQueued []) (SRunning []) (SDone []) (SFailed []) (SAsks []))

(defstruct Step
  [(name (slice u8))
   (state State)
   (machine (slice u8))
   (secs i64)
   (detail (slice u8))
   (from i64)
   (join i64)
   (col i64)
   (row i64)
   (born f64)
   (changed f64)])

(defsum Speaker (You []) (Agent []) (Cont []) (Tool []) (Result []) (Pending []) (Asks []))

;; A conversation line, plus where it was last drawn. Selection hit-tests against
;; what was actually put on screen rather than against a second copy of the
;; layout rules, which is the only way the two cannot drift.
(defstruct Line
  [(who Speaker)
   (text (slice u8))
   (trail (slice u8))
   (born f64)
   (top f64)
   (left f64)
   ;; The advance of the face it was drawn in. Every face here is fixed-pitch, so
   ;; this is all that is needed to turn an x into a character.
   (adv f64)])

;; A rail row. The rail is projects and what has happened in them, then the
;; library of workflows you can run in any of them. The differences are not
;; cosmetic: a project is a place, a run is history, an issue is a request, and
;; a workflow is a definition that has never run anywhere.
(defsum ItemKind
  (ItemProject [])
  (ItemRun [])
  (ItemIssue [])
  ;; The one heading over the library. Not a project and not selectable.
  (ItemLibrary [])
  (ItemWorkflow [])
  ;; "nothing has happened here yet", under an empty project.
  (ItemNote []))

(defstruct Item
  [(project (slice u8))
   (name (slice u8))
   (state State)
   (meta (slice u8))
   (kind ItemKind)
   ;; Index into the discovered workflow list for a workflow row, into the
   ;; issue list for an issue row, and -1 for a project heading.
   (source i64)])

;; A row you can click. Headings and notes are structure, not targets.
(defn item-selectable? [(it (ptr Item))] (-> bool)
  (match (.kind it)
    (ItemLibrary [] false)
    (ItemNote [] false)
    (_ true)))

(defn item-heading? [(it (ptr Item))] (-> bool)
  (match (.kind it)
    (ItemProject [] true)
    (ItemLibrary [] true)
    (_ false)))

(defn item-issue? [(it (ptr Item))] (-> bool)
  (match (.kind it) (ItemIssue [] true) (_ false)))

(defn item-run? [(it (ptr Item))] (-> bool)
  (match (.kind it) (ItemRun [] true) (_ false)))

(defn item-workflow? [(it (ptr Item))] (-> bool)
  (match (.kind it) (ItemWorkflow [] true) (_ false)))

(defn item-project? [(it (ptr Item))] (-> bool)
  (match (.kind it) (ItemProject [] true) (_ false)))

(defn item-note? [(it (ptr Item))] (-> bool)
  (match (.kind it) (ItemNote [] true) (_ false)))

(defn item-library? [(it (ptr Item))] (-> bool)
  (match (.kind it) (ItemLibrary [] true) (_ false)))

;; The open run, workflow, issue, or project, or -1 when that is not what is
;; open. Every caller wants one of these rather than the sum itself.
(defn view-run [(app (ptr App))] (-> i64)
  (match (.view app) (ViewRun [at] at) (_ -1)))

(defn view-workflow [(app (ptr App))] (-> i64)
  (match (.view app) (ViewWorkflow [at] at) (_ -1)))

(defn view-issue [(app (ptr App))] (-> i64)
  (match (.view app) (ViewIssue [at] at) (_ -1)))

(defn view-project [(app (ptr App))] (-> i64)
  (match (.view app) (ViewProject [at] at) (_ -1)))

;; Nothing is open: the window is the single prompt you write a new workflow or
;; a new issue into.
;; A workflow that works on an issue is not runnable on its own.
(defn needs-input? [(app (ptr App))] (-> bool)
  (and (>= (view-workflow app) 0) (.open-needs-input app)))

(defn view-nothing? [(app (ptr App))] (-> bool)
  (match (.view app) (ViewNothing [] true) (_ false)))

;; Is the composer writing an issue rather than a workflow? The two look the
;; same and land in different places, so every prompt in the window has to say
;; which one this is.
(defn issue-composer? [(app (ptr App))] (-> bool)
  (match (.compose app) (ComposeIssue [] true) (_ false)))

(defsum Compose (ComposeWorkflow []) (ComposeIssue []))

;; What the two right-hand panes are showing. One value, so "a run is open" and
;; "an issue is open" cannot both be true.
(defsum View
  (ViewNothing [])
  (ViewProject [(at i64)])
  (ViewRun [(at i64)])
  (ViewWorkflow [(at i64)])
  (ViewIssue [(at i64)]))

(defstruct App
  [(alc (ptr Allocator))
   (title (slice u8))
   (items (ArrayList Item))
   (steps (ArrayList Step))
   (lines (ArrayList Line))
   (input (ArrayList u8))
   (selected i64)
   (focus i64)
   (tick i64)
   (running bool)
   (now f64)
   (typed f64)
   (split-at f64)
   (hover-item i64)
   (hover-node i64)
   (hover-run bool)
   ;; The journal this workflow's state was read from, kept so the conversation
   ;; can be rebuilt for a different step without touching the disk again.
   (journal (slice u8))
   (factory (slice u8))
   ;; What is open in the middle and right panes.
   (view View)
   ;; The project everything acts in: what Run runs the workflow in, and where
   ;; ⌘I files an issue. Clicking anything under a project changes it.
   (project i64)
   ;; Its label, copied so the drawing code can name the project without
   ;; reaching into the world it came from.
   (project-label (slice u8))
   ;; What the composer is writing. ⌘N authors a workflow into the library;
   ;; ⌘I files an issue in the current project.
   (compose Compose)
   ;; A run was just started and its journal has not appeared yet. The workflow
   ;; it will belong to, and the newest run of that workflow at the moment it
   ;; was started, which is how the new one is recognised when it lands.
   (pending (slice u8))
   (pending-after i64)
   ;; When it was started, so a command that will never write a journal can be
   ;; reported instead of waited on forever.
   (pending-since f64)
   ;; The selection, as two points in the conversation: a line and a character
   ;; within it. Line -1 means there is none. Anchor is where the drag started
   ;; and head is where the pointer is, so a selection can run either way.
   (sel-line i64)
   (sel-cell i64)
   (sel-head-line i64)
   (sel-head-cell i64)
   (selecting bool)
   ;; The authoring conversation: 0 idle, 1 waiting for the service to answer,
   ;; 2 an agent is working. A workflow is designed by an agent, so ⌘N is a
   ;; conversation with one rather than a form that writes a file.
   (agent-stage i64)
   (agent-run (slice u8))
   (agent-conversation (slice u8))
   (agent-after i64)
   ;; What to send once the service answers, and how many commands have been
   ;; sent, which is what makes each one's id unique.
   (agent-prompt (slice u8))
   (agent-seq i64)
   (agent-since f64)
   ;; The workflow chosen to carry out the issue that is open, or -1 for the one
   ;; the project declares. Choosing is what a workflow that needs an issue is
   ;; for: you pick the pair, then run it.
   (chosen i64)
   ;; Does the open workflow need an issue before it can run? Copied here so the
   ;; drawing code can ask without reaching into the world it came from.
   (open-needs-input bool)
   ;; The run this window started and can therefore stop: its pid, and the run id
   ;; it belongs to. A run somebody else started is watchable but not stoppable.
   (run-pid i64)
   (pid-run-id (slice u8))
   ;; Whether the open run can be stopped from here, copied for the drawing code
   ;; the same way the project label is.
   (can-stop bool)
   ;; When the composer was last clicked or typed into. A click that changes
   ;; nothing on screen reads as a click that did not land, even when typing
   ;; would have gone there all along.
   (composer-lit f64)
   ;; How many characters fit on a line of the conversation, measured from the
   ;; pane rather than assumed. Text was wrapped at a constant while the pane
   ;; drew fewer columns, so every long line lost its tail to an ellipsis.
   (wrap-cols i64)
   ;; The width the lines currently in hand were wrapped at, so a resize can be
   ;; noticed and the view rebuilt.
   (lines-cols i64)
   ;; How far back from the end of the conversation the view is scrolled, in
   ;; points. Zero means pinned to the latest line, which is where a live run
   ;; wants to be.
   (scroll f64)
   (scroll-max f64)
   ;; Set to the old scroll limit when the conversation is about to grow, so the
   ;; next layout can keep the reader where they were instead of letting new
   ;; output shove the lines they are reading off the top. -1 when idle.
   (anchor f64)])

(defn state-word [(s State)] (-> (slice u8))
  (match s
    (SQueued [] "queued")
    (SRunning [] "running")
    (SDone [] "done")
    (SFailed [] "failed")
    (SAsks [] "asks")))

(defn mk-step [(name (slice u8)) (from i64) (join i64) (st State) (machine (slice u8)) (secs i64)] (-> Step)
  (let [s (alloc/stack Step)]
    (set! (.name s) name)
    (set! (.state s) st)
    (set! (.machine s) machine)
    (set! (.secs s) secs)
    (set! (.detail s) "")
    (set! (.from s) from)
    (set! (.join s) join)
    (set! (.col s) 0)
    (set! (.row s) 0)
    (load s)))

(defn mk-line [(who Speaker) (text (slice u8)) (trail (slice u8))] (-> Line)
  (let [l (alloc/stack Line)]
    (set! (.who l) who)
    (set! (.text l) text)
    (set! (.trail l) trail)
    (set! (.top l) -1.0)
    (set! (.left l) 0.0)
    (set! (.adv l) 0.0)
    (load l)))

(defn mk-item [(project (slice u8))
               (name (slice u8))
               (st State)
               (meta (slice u8))
               (kind ItemKind)
               (source i64)] (-> Item)
  (let [i (alloc/stack Item)]
    (set! (.project i) project)
    (set! (.name i) name)
    (set! (.state i) st)
    (set! (.meta i) meta)
    (set! (.kind i) kind)
    (set! (.source i) source)
    (load i)))

;; Column is dependency depth; row is arrival order within a column. Called after
;; any change to the step list, so the graph is never stale with respect to it.
(defn relayout! [(app (ptr App))] (-> i64)
  (let [n (al-len [Step] (.steps app))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [s (al-elem [Step] (field app steps) (load i))
                    from (.from s)
                    join (.join s)
                    base
                      (if (< from 0)
                          0
                          (+ 1 (.col (al-elem [Step] (field app steps) from))))
                    depth
                      (if (< join 0)
                          base
                          (let [jc
                                  (+ 1
                                     (.col (al-elem [Step] (field app steps) join)))]
                            (if (> jc base) jc base)))
                    (mut used) 0
                    (mut k) 0]
                (loop (if (>= (load k) (load i))
                          (break)
                          (do
                            (when (= (load (field (al-elem [Step]
                                                           (field app steps)
                                                           (load k))
                                                  col))
                                     depth)
                              (store! used (+ (load used) 1))
                              0)
                            (set! k (+ (load k) 1)))))
                (set! (.col s) depth)
                (set! (.row s) (load used))
                (set! i (+ (load i) 1)))))
    0))

;; When the window goes from one prompt to three panes, that transition has a
;; start time too.
(defn note-split! [(app (ptr App))] (-> i64)
  (when (<= (.split-at app) 0.0)
    (set! (field app split-at) (.now app))
    0)
  0)

(defn steps-clear! [(app (ptr App))] (-> i64)
  (set! (.steps app) (al-new [Step] (.alc app)))
  0)

(defn lines-clear! [(app (ptr App))] (-> i64)
  (set! (.lines app) (al-new [Line] (.alc app)))
  (sel-clear! app)
  0)

;; ------------------------------------------------------------- selection

;; Only the selection. Everything else about the app survives losing it: this is
;; called whenever the conversation is rebuilt, which happens constantly while a
;; run is going.
(defn sel-clear! [(app (ptr App))] (-> i64)
  (set! (.sel-line app) -1)
  (set! (.sel-head-line app) -1)
  (set! (.selecting app) false)
  0)

(defn sel-active? [(app (ptr App))] (-> bool)
  (and (>= (.sel-line app) 0)
       (and (>= (.sel-head-line app) 0)
            (or (!= (.sel-line app) (.sel-head-line app))
                (!= (.sel-cell app) (.sel-head-cell app))))))

;; The selection in reading order, whichever way it was dragged.
(defn sel-first-line [(app (ptr App))] (-> i64)
  (if (<= (.sel-line app) (.sel-head-line app)) (.sel-line app) (.sel-head-line app)))

(defn sel-last-line [(app (ptr App))] (-> i64)
  (if (<= (.sel-line app) (.sel-head-line app)) (.sel-head-line app) (.sel-line app)))

(defn sel-first-cell [(app (ptr App))] (-> i64)
  (cond (< (.sel-line app) (.sel-head-line app)) (.sel-cell app)
        (> (.sel-line app) (.sel-head-line app)) (.sel-head-cell app)
        :else (if (<= (.sel-cell app) (.sel-head-cell app)) (.sel-cell app) (.sel-head-cell app))))

(defn sel-last-cell [(app (ptr App))] (-> i64)
  (cond (< (.sel-line app) (.sel-head-line app)) (.sel-head-cell app)
        (> (.sel-line app) (.sel-head-line app)) (.sel-cell app)
        :else (if (<= (.sel-cell app) (.sel-head-cell app)) (.sel-head-cell app) (.sel-cell app))))

(defn sel-start! [(app (ptr App)) (line i64) (cell i64)] (-> i64)
  (set! (.sel-line app) line)
  (set! (.sel-cell app) cell)
  (set! (.sel-head-line app) line)
  (set! (.sel-head-cell app) cell)
  (set! (.selecting app) true)
  0)

(defn sel-extend! [(app (ptr App)) (line i64) (cell i64)] (-> i64)
  (when (>= (.sel-line app) 0)
    (set! (.sel-head-line app) line)
    (set! (.sel-head-cell app) cell)
    0)
  0)

(defn sel-all! [(app (ptr App))] (-> i64)
  (let [n (al-len [Line] (.lines app))]
    (if (= n 0)
        0
        (do
          (set! (.sel-line app) 0)
          (set! (.sel-cell app) 0)
          (set! (.sel-head-line app) (- n 1))
          (set! (.sel-head-cell app) 100000)
          (set! (.selecting app) false)
  (set! (.agent-stage app) 0)
  (set! (.agent-run app) "")
  (set! (.agent-conversation app) "")
  (set! (.agent-after app) 0)
  (set! (.agent-prompt app) "")
  (set! (.agent-seq app) 0)
  (set! (.agent-since app) 0.0)
  (set! (.chosen app) -1)
  (set! (.open-needs-input app) false)
  (set! (.run-pid app) -1)
  (set! (.pid-run-id app) "")
  (set! (.can-stop app) false)
  (set! (.composer-lit app) 0.0)
  (set! (.wrap-cols app) 52)
  (set! (.lines-cols app) 52)
          0))))

;; Everything that enters the interface is stamped with when it arrived, which
;; is the whole animation model: the view eases on the age of a thing rather
;; than on a running tween somebody has to remember to advance.
(defn push-step! [(app (ptr App)) (s Step)] (-> i64)
  (al-push! [Step] (field app steps) s)
  (let [at (- (al-len [Step] (.steps app)) 1)
        p (al-elem [Step] (field app steps) at)]
    (set! (field p born) (.now app))
    (set! (field p changed) (.now app)))
  (relayout! app)
  0)

(defn push-line! [(app (ptr App)) (l Line)] (-> i64)
  (al-push! [Line] (field app lines) l)
  (let [at (- (al-len [Line] (.lines app)) 1)
        p (al-elem [Line] (field app lines) at)]
    (set! (field p born) (.now app)))
  0)

;; A state change is a visible event, so it gets its own timestamp.
(defn set-step-state! [(app (ptr App)) (at i64) (st State)] (-> i64)
  (let [s (step-at app at)]
    (set! (field s state) st)
    (set! (field s changed) (.now app))
    0))

(defn step-count [(app (ptr App))] (-> i64)
  (al-len [Step] (.steps app)))

(defn step-at [(app (ptr App)) (i i64)] (-> (ptr Step))
  (al-elem [Step] (field app steps) i))

(defn count-in-state [(app (ptr App)) (want (slice u8))] (-> i64)
  (let [n (step-count app)
        (mut i) 0
        (mut found) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (state-word (load (field (step-at app (load i)) state))) want)
                  (store! found (+ (load found) 1))
                  0)
                (set! i (+ (load i) 1)))))
    (load found)))

;; Has anything in this workflow actually run? Before that, the right pane is the
;; plan conversation rather than any one step's transcript.
(defn started? [(app (ptr App))] (-> bool)
  (> (+ (count-in-state app "running")
        (+ (count-in-state app "done")
           (+ (count-in-state app "failed") (count-in-state app "asks"))))
     0))

;; The row the open run occupies, or -1. Rows are grouped under projects, so
;; which row that is depends on what comes before it.
(defn open-row [(app (ptr App))] (-> i64)
  (let [n (al-len [Item] (.items app))
        want (view-run app)
        (mut i) 0
        (mut found) -1]
    (loop (if (or (>= (load i) n) (>= (load found) 0))
              (break)
              (let [it (al-elem [Item] (field app items) (load i))]
                (when (and (item-run? it) (and (>= want 0) (= (.source it) want)))
                  (store! found (load i))
                  0)
                (set! i (+ (load i) 1)))))
    (load found)))

;; The rail row for the open run reports its aggregate: the worst thing that
;; needs a person, then whatever is still moving.
(defn rail-sync! [(app (ptr App))] (-> i64)
  (let [row (open-row app)]
    (if (< row 0) 0 (rail-sync-row! app row))))

(defn rail-sync-row! [(app (ptr App)) (row i64)] (-> i64)
  (let [it (al-elem [Item] (field app items) row)
        n (step-count app)
        done (count-in-state app "done")
        asks (count-in-state app "asks")
        failed (count-in-state app "failed")
        running (count-in-state app "running")]
    (set! (.state it)
          (if (> asks 0)
              (SAsks)
              (if (> failed 0)
                  (SFailed)
                  (if (> running 0) (SRunning) (if (and (> n 0) (= done n)) (SDone) (SQueued))))))
    0))

(defn app-init! [(app (ptr App)) (a (ptr Allocator))] (-> i64)
  (set! (.alc app) a)
  (set! (.title app) "untitled")
  (set! (.input app) (al-new [u8] a))
  (set! (.selected app) 1)
  (set! (.focus app) 0)
  (set! (.tick app) 0)
  (set! (.running app) false)
  (set! (.now app) 0.0)
  (set! (.typed app) 0.0)
  (set! (.split-at app) 0.0)
  (set! (.hover-item app) -1)
  (set! (.hover-node app) -1)
  (set! (.hover-run app) false)
  (set! (.journal app) "")
  (set! (.factory app) "")
  (set! (.view app) (ViewNothing))
  (set! (.project app) -1)
  (set! (.project-label app) "")
  (set! (.compose app) (ComposeWorkflow))
  (set! (.pending app) "")
  (set! (.pending-after app) 0)
  (set! (.pending-since app) 0.0)
  (set! (.sel-line app) -1)
  (set! (.sel-cell app) 0)
  (set! (.sel-head-line app) -1)
  (set! (.sel-head-cell app) 0)
  (set! (.selecting app) false)
  (set! (.agent-stage app) 0)
  (set! (.agent-run app) "")
  (set! (.agent-conversation app) "")
  (set! (.agent-after app) 0)
  (set! (.agent-prompt app) "")
  (set! (.agent-seq app) 0)
  (set! (.agent-since app) 0.0)
  (set! (.chosen app) -1)
  (set! (.open-needs-input app) false)
  (set! (.run-pid app) -1)
  (set! (.pid-run-id app) "")
  (set! (.can-stop app) false)
  (set! (.composer-lit app) 0.0)
  (set! (.wrap-cols app) 52)
  (set! (.lines-cols app) 52)
  (set! (.scroll app) 0.0)
  (set! (.scroll-max app) 0.0)
  (set! (.anchor app) -1.0)
  (steps-clear! app)
  (lines-clear! app)
  0)

(defn own-str [(a (ptr Allocator)) (s (slice u8))] (-> (slice u8))
  (let [n (slice-len [u8] s)]
    (if (= n 0)
        ""
        (let [p (unwrap-ptr [u8] (alloc-slice [u8] a n))
              (mut i) 0]
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (set! (primitive/index p (load i)) (slice-get [u8] s (load i)))
                      (set! i (+ (load i) 1)))))
          (slice-new [u8] p n)))))

;; Wrap on spaces at `width` characters, first line marked, the rest continuations.
;; Wrap at whatever the pane can actually draw. Callers pass the app's measure
;; rather than a number they picked.
(defn wrap-width [(app (ptr App))] (-> i64)
  (let [cols (.wrap-cols app)]
    (if (< cols 16) 16 cols)))

(defn push-wrapped! [(app (ptr App)) (who Speaker) (text (slice u8)) (width i64)] (-> i64)
  (let [n (slice-len [u8] text)
        (mut start) 0
        (mut first) true]
    (loop (if (>= (load start) n)
              (break)
              (let [remaining (- n (load start))
                    take (if (<= remaining width) remaining width)
                    (mut cut) (+ (load start) take)]
                (when (< (load cut) n)
                  (loop (if (or (<= (load cut) (load start))
                                (= (primitive/cast i64 (slice-get [u8] text (load cut))) 32))
                            (break)
                            (store! cut (- (load cut) 1))))
                  (when (<= (load cut) (load start))
                    (store! cut (+ (load start) take))
                    0)
                  0)
                (push-line! app
                            (mk-line (if (load first) who (Cont))
                                     (subslice [u8] text (load start) (load cut))
                                     ""))
                (set! first false)
                (set! start
                      (if (and (< (load cut) n)
                               (= (primitive/cast i64 (slice-get [u8] text (load cut))) 32))
                          (+ (load cut) 1)
                          (load cut))))))
    0))

(defn input-slice [(app (ptr App))] (-> (slice u8))
  (al-slice [u8] (.input app)))

(defn input-clear! [(app (ptr App))] (-> i64)
  (set! (.input app) (al-new [u8] (.alc app)))
  0)

(defn input-push! [(app (ptr App)) (b u8)] (-> i64)
  (al-push! [u8] (field app input) b)
  0)

(defn input-backspace! [(app (ptr App))] (-> i64)
  (al-pop! [u8] (field app input))
  0)

;; The words after `prefix`, bounded, or "" when the prefix is absent.
(defn word-after [(text (slice u8)) (prefix (slice u8))] (-> (slice u8))
  (match (str-find text prefix)
    (Some [at]
          (let [start (+ at (slice-len [u8] prefix))
                n (slice-len [u8] text)
                stop (if (> (- n start) 18) (+ start 18) n)]
            (str-trim (subslice [u8] text start stop))))
    (None [] "")))

;; A short name for a new workflow, taken from the request itself.
;; A short name for a new workflow, taken from the request itself and cut on a
;; word boundary rather than mid-word.
(defn short-name [(text (slice u8))] (-> (slice u8))
  (let [n (slice-len [u8] text)]
    (if (<= n 18)
        (str-trim text)
        (let [(mut cut) 18]
          (loop (if (or (<= (load cut) 4)
                        (= (primitive/cast i64 (slice-get [u8] text (load cut))) 32))
                    (break)
                    (set! cut (- (load cut) 1))))
          (str-trim (subslice [u8] text 0 (load cut)))))))

(defn scroll-by! [(app (ptr App)) (delta f64)] (-> i64)
  (let [next (+ (.scroll app) delta)]
    (set! (.scroll app)
          (if (< next 0.0)
              0.0
              (if (> next (.scroll-max app)) (.scroll-max app) next)))
    0))

(defn scroll-reset! [(app (ptr App))] (-> i64)
  (set! (.scroll app) 0.0)
  0)
